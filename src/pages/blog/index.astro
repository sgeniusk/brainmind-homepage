  <script>
    // ── 시리즈 ID 기준으로 TOC + 북 양방향 동기화 ──
    function syncSeries(seriesId: string, newState: string) {
      const book = document.getElementById('book-' + seriesId) as HTMLElement | null;
      const toc  = document.getElementById('toc-'  + seriesId) as HTMLElement | null;
      if (book) book.dataset.open = newState;
      if (toc)  toc.dataset.open  = newState;
    }

    // TOC 버튼 클릭 → 북도 연동
    document.querySelectorAll('[data-toc-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('.toc-series-wrap') as HTMLElement | null;
        if (!wrap) return;
        const newState = wrap.dataset.open === 'true' ? 'false' : 'true';
        const seriesId = wrap.id.replace('toc-', '');
        syncSeries(seriesId, newState);
      });
    });

    // 북 목차 버튼 클릭 → TOC도 연동
    document.querySelectorAll('[data-book-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const book = btn.closest('.series-book') as HTMLElement | null;
        if (!book) return;
        const newState = book.dataset.open === 'true' ? 'false' : 'true';
        const seriesId = book.id.replace('book-', '');
        syncSeries(seriesId, newState);
      });
    });
  </script>
</BaseLayout>
