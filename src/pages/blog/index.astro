  <script>
    // ── TOC 시리즈 접기/펼치기 ──
    document.querySelectorAll('[data-toc-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('.toc-series-wrap') as HTMLElement;
        if (!wrap) return;
        wrap.dataset.open = wrap.dataset.open === 'true' ? 'false' : 'true';
      });
    });

    // ── 메인 북 목차 접기/펼치기 ──
    document.querySelectorAll('[data-book-toggle]').forEach(btn => {
      btn.addEventListener('click', () => {
        const book = btn.closest('.series-book') as HTMLElement;
        if (!book) return;
        const isOpen = book.dataset.open === 'true';
        book.dataset.open = isOpen ? 'false' : 'true';

        // TOC도 동기화: 같은 시리즈 펼침
        const tocId = 'toc-' + book.id.replace('book-', '');
        const tocWrap = document.getElementById(tocId);
        if (tocWrap && !isOpen) {
          tocWrap.dataset.open = 'true';
        }
      });
    });
  </script>
</BaseLayout>
