---
import BaseLayout from '../../layouts/BaseLayout.astro';

type BlogFrontmatter = {
  blog_id: string;
  series: string;
  series_part: number;
  series_chapter: number;
  title: string;
  subtitle?: string;
  category?: string;
  reading_time?: string;
  teaser?: string;
  status?: string;
  created?: string;
  published?: string;
};

type BlogModule = {
  frontmatter: BlogFrontmatter;
};

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

/* --- Series 1 --- */
const s1Modules = Object.values(import.meta.glob('./post-[0-9][0-9].md', { eager: true })) as BlogModule[];
const s1Posts = s1Modules
  .map(({ frontmatter }) => ({ ...frontmatter, href: `${base}blog/post-${String(frontmatter.series_chapter).padStart(2, '0')}/` }))
  .sort((a, b) => a.series_chapter - b.series_chapter);

/* --- Series 2 --- */
const s2Modules = Object.values(import.meta.glob('./post-s2-*.md', { eager: true })) as BlogModule[];
const s2Posts = s2Modules
  .map(({ frontmatter }) => ({ ...frontmatter, href: `${base}blog/post-s2-${String(frontmatter.series_chapter).padStart(2, '0')}/` }))
  .sort((a, b) => a.series_chapter - b.series_chapter);

/* --- Series 3 --- */
const s3Modules = Object.values(import.meta.glob('./post-s3-*.md', { eager: true })) as BlogModule[];
const s3Posts = s3Modules
  .map(({ frontmatter }) => ({ ...frontmatter, href: `${base}blog/post-s3-${String(frontmatter.series_chapter).padStart(2, '0')}/` }))
  .sort((a, b) => a.series_chapter - b.series_chapter);

/* --- Helpers --- */
const makeParts = (posts: typeof s1Posts) => ({
  prologue: posts.find(p => p.series_chapter === 0),
  part1:    posts.filter(p => p.series_chapter >= 1  && p.series_chapter <= 4),
  part2:    posts.filter(p => p.series_chapter >= 5  && p.series_chapter <= 8),
  part3:    posts.filter(p => p.series_chapter >= 9  && p.series_chapter <= 12),
  epilogue: posts.find(p => p.series_chapter === 13),
});

const s1 = makeParts(s1Posts);
const s2 = makeParts(s2Posts);
const s3 = makeParts(s3Posts);

const seriesTitle = s1Posts[0]?.series ?? '생각이 사라지기 전에';
const s2Title     = s2Posts[0]?.series ?? '몸이 기억하는 것들';
const s3Title     = s3Posts[0]?.series ?? '연결이 사라지기 전에';

const sections = [
  { id: 'part-1',    label: 'Part 1', title: '사라지고 있는 것들', accent: 'var(--accent)', posts: s1.part1 },
  { id: 'part-2',    label: 'Part 2', title: '보이지 않는 설계',   accent: 'var(--alert)',  posts: s1.part2 },
  { id: 'part-3',    label: 'Part 3', title: '지키기로 한 것들',   accent: 'var(--brain)',  posts: s1.part3 },
];
const s2Sections = [
  { id: 's2-part-1', label: 'Part 1', title: '무시된 신호들', accent: 'var(--accent)', posts: s2.part1 },
  { id: 's2-part-2', label: 'Part 2', title: '몸의 문법',     accent: 'var(--alert)',  posts: s2.part2 },
  { id: 's2-part-3', label: 'Part 3', title: '다시 듣기',     accent: 'var(--brain)',  posts: s2.part3 },
];
const s3Sections = [
  { id: 's3-part-1', label: 'Part 1', title: '외주된 연결들', accent: 'var(--accent)', posts: s3.part1 },
  { id: 's3-part-2', label: 'Part 2', title: '연결의 문법',   accent: 'var(--alert)',  posts: s3.part2 },
  { id: 's3-part-3', label: 'Part 3', title: '너머',          accent: 'var(--alert)',  posts: s3.part3 },
];

const getStatusLabel = (s?: string) => s === 'published' ? '공개' : '준비 중';
const getStatusClass = (s?: string) => s === 'published' ? 'status-published' : 'status-draft';
---

<BaseLayout title="블로그 — 뇌와 마음사이" activePage="blog">
  <Fragment slot="head">
    <style>
      /* ── Shell ── */
      .blog-shell{max-width:1180px;margin:0 auto;padding:7.25rem 1.5rem 4.5rem}
      .blog-grid{display:grid;grid-template-columns:minmax(260px,300px) minmax(0,1fr);gap:2rem;align-items:start}

      /* ── Cards ── */
      .toc-card,.hero-card,.section-card,.prologue-card,.epilogue-card{
        background:var(--bg-card);border:1px solid var(--card-border);
        border-radius:28px;box-shadow:var(--glass-shadow);
      }
      .toc-card{position:sticky;top:6.25rem;padding:1.35rem}
      .toc-head{padding-bottom:.9rem;border-bottom:1px solid var(--divider);margin-bottom:.9rem}
      .toc-title{font-size:1.08rem;font-weight:800;letter-spacing:-.02em;color:var(--text)}
      .toc-subtitle{font-size:.79rem;color:var(--text-muted);margin-top:.3rem;line-height:1.6}

      /* ── TOC Accordion ── */
      .toc-group-label{font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);margin:.15rem 0 .25rem}
      .toc-series-btn{
        display:flex;align-items:flex-start;gap:.65rem;
        padding:.58rem .75rem;border-radius:14px;
        cursor:pointer;background:none;border:none;width:100%;
        text-align:left;font-family:inherit;
        color:var(--text-dim);transition:background .22s,color .22s;
      }
      .toc-series-btn:hover{background:var(--card-hover-bg);color:var(--text)}
      .toc-num{font-size:.72rem;font-weight:800;min-width:1.8rem;line-height:1.7}
      .toc-copy{display:flex;flex-direction:column;gap:.08rem;flex:1;min-width:0}
      .toc-copy strong{font-size:.88rem;color:var(--text);font-weight:700;word-break:keep-all}
      .toc-copy span{font-size:.76rem;color:var(--text-muted);line-height:1.5;word-break:keep-all}
      .toc-chev{flex-shrink:0;margin-top:.22rem;font-size:.86rem;color:var(--text-muted);transition:transform .32s cubic-bezier(.4,0,.2,1)}
      .toc-series-wrap[data-open="false"] .toc-chev{transform:rotate(-90deg)}
      .toc-pills-wrap{overflow:hidden;max-height:200px;opacity:1;transition:max-height .38s cubic-bezier(.4,0,.2,1),opacity .28s ease}
      .toc-series-wrap[data-open="false"] .toc-pills-wrap{max-height:0;opacity:0}
      .toc-divider{padding-top:.55rem;border-top:1px solid var(--divider);margin-bottom:.1rem}

      /* ── Blog content ── */
      .blog-content{display:flex;flex-direction:column;gap:1.4rem}

      /* ── Hero card ── */
      .hero-card{padding:2rem 2rem 1.75rem;position:relative;overflow:hidden}
      .hero-card::before{content:'';position:absolute;inset:auto auto -100px -60px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(255,112,67,.13) 0%,transparent 70%);pointer-events:none}
      .hero-badges{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.9rem}
      .hero-kicker{display:inline-flex;align-items:center;gap:.42rem;padding:.36rem .78rem;border-radius:999px;font-size:.73rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
      .hero-meta{font-size:.86rem;color:var(--text-muted)}
      .hero-title{font-size:clamp(1.9rem,4vw,2.8rem);font-weight:800;letter-spacing:-.04em;line-height:1.12;color:var(--text);margin-bottom:.65rem;word-break:keep-all}
      .hero-desc{font-size:1.01rem;color:var(--text-dim);line-height:1.82;word-break:keep-all;max-width:58ch}
      .hero-quote{margin-top:1.25rem;padding:1rem 1.2rem;border-left:3px solid var(--accent);background:rgba(255,112,67,.04);border-radius:0 14px 14px 0;font-size:.94rem;color:var(--text-dim);line-height:1.75;word-break:keep-all}

      /* ── Book accordion ── */
      .book-toggle-row{display:flex;align-items:center;justify-content:flex-end;margin-top:1.05rem;padding-top:.85rem;border-top:1px solid var(--divider)}
      .book-toggle-btn{
        display:inline-flex;align-items:center;gap:.38rem;
        padding:.36rem .82rem;border-radius:999px;
        border:1px solid var(--divider);background:none;
        color:var(--text-muted);font-size:.77rem;font-weight:700;
        letter-spacing:.04em;cursor:pointer;font-family:inherit;
        transition:all .22s ease;
      }
      .book-toggle-btn:hover{border-color:var(--accent);color:var(--accent)}
      .book-chev{transition:transform .35s cubic-bezier(.4,0,.2,1)}
      .series-book[data-open="false"] .book-chev{transform:rotate(180deg)}
      .book-toggle-btn .lbl-open{display:none}
      .book-toggle-btn .lbl-close{display:inline}
      .series-book[data-open="false"] .book-toggle-btn .lbl-open{display:inline}
      .series-book[data-open="false"] .book-toggle-btn .lbl-close{display:none}
      .book-pages{
        display:flex;flex-direction:column;gap:1.35rem;
        overflow:hidden;max-height:5000px;opacity:1;
        margin-top:1.35rem;
        transition:max-height .65s cubic-bezier(.4,0,.2,1),opacity .4s ease,margin-top .35s ease;
      }
      .series-book[data-open="false"] .book-pages{max-height:0;opacity:0;margin-top:0;pointer-events:none}

      /* ── Post cards ── */
      .prologue-card,.epilogue-card{padding:1.1rem 1.15rem}
      .post-card{
        display:flex;align-items:flex-start;gap:1rem;
        padding:1rem 1.05rem;border-radius:20px;text-decoration:none;
        background:var(--bg-card);border:1px solid var(--card-border);
        transition:all .24s cubic-bezier(.16,1,.3,1);
      }
      .post-card:hover{transform:translateY(-2px);border-color:rgba(255,112,67,.22);background:var(--card-hover-bg);box-shadow:0 6px 24px rgba(0,0,0,.07)}
      .post-card-copy{flex:1;min-width:0}
      .post-card-top{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-bottom:.32rem}
      .post-card-title{font-size:1.03rem;font-weight:700;color:var(--text);word-break:keep-all;margin-bottom:.28rem}
      .post-card-desc{font-size:.86rem;color:var(--text-dim);line-height:1.65;word-break:keep-all}
      .post-card-num{font-size:.78rem;font-weight:800;color:var(--accent);min-width:2rem;line-height:1.75;flex-shrink:0}
      .post-card-meta{font-size:.74rem;color:var(--text-muted)}
      .status-pill{display:inline-flex;align-items:center;padding:.2rem .5rem;border-radius:999px;font-size:.68rem;font-weight:800;letter-spacing:.05em}
      .status-published{background:rgba(76,175,80,.1);color:#43A047}
      .status-draft{background:rgba(255,112,67,.1);color:var(--accent)}

      /* ── Section card ── */
      .section-card{padding:1.2rem 1.2rem 1.3rem}
      .section-head{display:flex;align-items:center;gap:.9rem;margin-bottom:.9rem}
      .section-line{flex:1;height:1px;background:var(--divider)}
      .section-label{font-size:.73rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
      .section-title{font-size:1.15rem;font-weight:800;letter-spacing:-.02em;color:var(--text);margin-bottom:.2rem}
      .section-desc{font-size:.83rem;color:var(--text-muted);line-height:1.6}
      .section-list{display:flex;flex-direction:column;gap:.65rem;margin-top:.85rem}

      /* ── Responsive ── */
      @media(max-width:960px){
        .blog-shell{padding-top:6.75rem}
        .blog-grid{grid-template-columns:1fr}
        .toc-card{position:static}
      }
      @media(max-width:640px){
        .blog-shell{padding-left:1rem;padding-right:1rem}
        .hero-card,.section-card,.prologue-card,.epilogue-card,.toc-card{border-radius:20px}
        .hero-card{padding:1.35rem}
        .section-card{padding:.95rem}
        .post-card{gap:.75rem;padding:.85rem}
      }
    </style>
  </Fragment>

  <div class="blog-shell">
    <div class="blog-grid">

      <!-- ══ 서재 사이드바 ══ -->
      <aside class="toc-card reveal">
        <div class="toc-head">
          <p class="toc-title">
            <iconify-icon icon="solar:library-bold-duotone" style="font-size:1.1rem;color:var(--accent);vertical-align:-.15em;margin-right:.3rem;"></iconify-icon>
            서재
          </p>
          <p class="toc-subtitle">연재 흐름을 따라가거나, 관심 있는 장부터 바로 읽을 수 있습니다.</p>
        </div>

        <!-- S1 -->
        <div class="toc-series-wrap" data-open="true" id="toc-s1">
          <div class="toc-group-label">시리즈 1</div>
          <button class="toc-series-btn" data-toc-toggle>
            <span class="toc-num" style="color:var(--accent);">S1</span>
            <span class="toc-copy">
              <strong>{seriesTitle}</strong>
              <span>{s1Posts.length}편 · AI 시대를 건너는 에세이</span>
            </span>
            <iconify-icon icon="solar:alt-arrow-down-linear" class="toc-chev"></iconify-icon>
          </button>
          <div class="toc-pills-wrap">
            <div style="display:flex;flex-wrap:wrap;gap:.38rem;padding:.15rem .15rem .6rem;">
              {s1.prologue && <a href={s1.prologue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.08);color:var(--accent);text-decoration:none;">프롤로그</a>}
              {sections.map(s => <a href={`#${s.id}`} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.08);color:var(--accent);text-decoration:none;">{s.label} {s.title}</a>)}
              {s1.epilogue && <a href={s1.epilogue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.08);color:var(--accent);text-decoration:none;">에필로그</a>}
            </div>
          </div>
        </div>

        <!-- S2 -->
        {s2Posts.length > 0 && (
          <Fragment>
            <div class="toc-divider"></div>
            <div class="toc-series-wrap" data-open="false" id="toc-s2">
              <div class="toc-group-label">시리즈 2</div>
              <button class="toc-series-btn" data-toc-toggle>
                <span class="toc-num" style="color:#0288D1;">S2</span>
                <span class="toc-copy">
                  <strong>{s2Title}</strong>
                  <span>{s2Posts.length}편 · 뇌와 몸 사이에서</span>
                </span>
                <iconify-icon icon="solar:alt-arrow-down-linear" class="toc-chev"></iconify-icon>
              </button>
              <div class="toc-pills-wrap">
                <div style="display:flex;flex-wrap:wrap;gap:.38rem;padding:.15rem .15rem .6rem;">
                  {s2.prologue && <a href={s2.prologue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(2,136,209,.08);color:#0288D1;text-decoration:none;">프롤로그</a>}
                  {s2Sections.map(s => <a href={`#${s.id}`} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(2,136,209,.08);color:#0288D1;text-decoration:none;">{s.label} {s.title}</a>)}
                  {s2.epilogue && <a href={s2.epilogue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(2,136,209,.08);color:#0288D1;text-decoration:none;">에필로그</a>}
                </div>
              </div>
            </div>
          </Fragment>
        )}

        <!-- S3 -->
        {s3Posts.length > 0 && (
          <Fragment>
            <div class="toc-divider"></div>
            <div class="toc-series-wrap" data-open="false" id="toc-s3">
              <div class="toc-group-label">시리즈 3</div>
              <button class="toc-series-btn" data-toc-toggle>
                <span class="toc-num" style="color:var(--alert);">S3</span>
                <span class="toc-copy">
                  <strong>{s3Title}</strong>
                  <span>{s3Posts.length}편 · AI 이후 시대의 관계</span>
                </span>
                <iconify-icon icon="solar:alt-arrow-down-linear" class="toc-chev"></iconify-icon>
              </button>
              <div class="toc-pills-wrap">
                <div style="display:flex;flex-wrap:wrap;gap:.38rem;padding:.15rem .15rem .6rem;">
                  {s3.prologue && <a href={s3.prologue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.07);color:var(--alert);text-decoration:none;">프롤로그</a>}
                  {s3Sections.map(s => <a href={`#${s.id}`} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.07);color:var(--alert);text-decoration:none;">{s.label} {s.title}</a>)}
                  {s3.epilogue && <a href={s3.epilogue.href} style="font-size:.7rem;font-weight:700;padding:.2rem .52rem;border-radius:999px;background:rgba(255,112,67,.07);color:var(--alert);text-decoration:none;">에필로그</a>}
                </div>
              </div>
            </div>
          </Fragment>
        )}
      </aside>

      <!-- ══ 메인 콘텐츠 (S1 → S2 → S3 순) ══ -->
      <section class="blog-content">

        <!-- ── S1 ── -->
        <div class="series-book" id="book-s1" data-open="true">
          <div class="hero-card reveal" id="series-overview">
            <div class="hero-badges">
              <span class="hero-kicker" style="background:rgba(255,112,67,.08);border:1px solid rgba(255,112,67,.22);color:var(--accent);">
                <iconify-icon icon="solar:pen-new-round-bold-duotone" style="font-size:.88rem;"></iconify-icon>
                Essay Series 1
              </span>
              <span class="hero-meta">{s1Posts.length}편 · 3파트 · 2026</span>
            </div>
            <h2 class="hero-title">{seriesTitle}</h2>
            <p class="hero-desc">AI 시대를 건너는 에세이입니다. 사라지고 있는 것들을 관찰하고, 그 뒤의 구조를 해부하고, 결국 무엇을 지키기로 할지 천천히 묻습니다.</p>
            <div class="hero-quote">"AI에게 글을 맡긴 날, 편리함과 불안이 동시에 왔습니다. 이건 효율인가, 포기인가. 이 질문에서 시작합니다."</div>
            <div class="book-toggle-row">
              <button class="book-toggle-btn" data-book-toggle>
                <span class="lbl-close">목차 접기</span><span class="lbl-open">목차 펼치기</span>
                <iconify-icon icon="solar:alt-arrow-up-linear" class="book-chev" style="font-size:.86rem;"></iconify-icon>
              </button>
            </div>
          </div>
          <div class="book-pages">
            {s1.prologue && (
              <div class="prologue-card">
                <a class="post-card" href={s1.prologue.href}>
                  <span class="post-card-num">{String(s1.prologue.series_chapter).padStart(2,'0')}</span>
                  <div class="post-card-copy">
                    <div class="post-card-top">
                      <span class={`status-pill ${getStatusClass(s1.prologue.status)}`}>{getStatusLabel(s1.prologue.status)}</span>
                      <span class="post-card-meta">{s1.prologue.reading_time}</span>
                    </div>
                    <p class="post-card-title">{s1.prologue.title}</p>
                    <p class="post-card-desc">{s1.prologue.teaser ?? s1.prologue.subtitle}</p>
                  </div>
                </a>
              </div>
            )}
            {sections.map((section, i) => (
              <div class="section-card" id={section.id}>
                <div class="section-head">
                  <div class="section-line"></div>
                  <span class="section-label" style={`color:${section.accent}`}>{section.label}</span>
                  <div class="section-line"></div>
                </div>
                <p class="section-title">{section.title}</p>
                <p class="section-desc">
                  {i === 0 && '불편하지만 분명히 사라지고 있는 감각과 습관을 먼저 관찰합니다.'}
                  {i === 1 && '편의 뒤에 숨은 설계, 소유, 동의, 중독의 구조를 따라갑니다.'}
                  {i === 2 && '결국 무엇을 직접 붙들고 살아갈지에 대한 선택으로 돌아옵니다.'}
                </p>
                <div class="section-list">
                  {section.posts.map(post => (
                    <a class="post-card" href={post.href}>
                      <span class="post-card-num">{String(post.series_chapter).padStart(2,'0')}</span>
                      <div class="post-card-copy">
                        <div class="post-card-top">
                          <span class={`status-pill ${getStatusClass(post.status)}`}>{getStatusLabel(post.status)}</span>
                          <span class="post-card-meta">{post.reading_time}</span>
                        </div>
                        <p class="post-card-title">{post.title}</p>
                        <p class="post-card-desc">{post.teaser ?? post.subtitle}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            {s1.epilogue && (
              <div class="epilogue-card">
                <a class="post-card" href={s1.epilogue.href}>
                  <span class="post-card-num">{String(s1.epilogue.series_chapter).padStart(2,'0')}</span>
                  <div class="post-card-copy">
                    <div class="post-card-top">
                      <span class={`status-pill ${getStatusClass(s1.epilogue.status)}`}>{getStatusLabel(s1.epilogue.status)}</span>
                      <span class="post-card-meta">{s1.epilogue.reading_time}</span>
                    </div>
                    <p class="post-card-title">{s1.epilogue.title}</p>
                    <p class="post-card-desc">{s1.epilogue.teaser ?? s1.epilogue.subtitle}</p>
                  </div>
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- ── S2 ── -->
        {s2Posts.length > 0 && (
          <>
