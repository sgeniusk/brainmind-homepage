                        <p class="post-card-desc">{s2.epilogue.teaser ?? s2.epilogue.subtitle}</p>
                      </div>
                    </a>
                  </div>
                )}
              </div>
            </div>
          </>
        )}

        <!-- ── S3 ── -->
        {s3Posts.length > 0 && (
          <>
            <div class="series-book" id="book-s3" data-open="false">
              <div class="hero-card reveal" id="series-3-overview" style="border-color:rgba(255,112,67,.18);">
                <div class="hero-badges">
                  <span class="hero-kicker" style="background:rgba(255,112,67,.06);border:1px solid rgba(255,112,67,.18);color:var(--alert);">
                    <iconify-icon icon="solar:users-group-two-rounded-bold-duotone" style="font-size:.88rem;"></iconify-icon>
                    Essay Series 3
                  </span>
                  <span class="hero-meta">{s3Posts.length}편 · 3파트 · 2026</span>
                </div>
                <h2 class="hero-title">{s3Title}</h2>
                <p class="hero-desc">AI가 친구를 고르고, 앱이 사랑을 주선하고, 챗봇이 위로한다. 그런데 고독 지수는 사상 최고다. AI 이후 시대의 연결을 바라봅니다.</p>
                <div class="hero-quote" style="border-color:var(--alert);background:rgba(255,112,67,.03);">"AI 친구가 생겼다. 위로받았는데 화면을 닫고 나면 이상하게 더 외로웠다."</div>
