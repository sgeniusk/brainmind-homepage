---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="영상 — 뇌와 마음사이" activePage="videos">


<!-- HERO -->
<section style="padding:7rem 0 4rem;position:relative;overflow:hidden;">
  <!-- Decorative faint play icon -->
  <div style="position:absolute;right:-2rem;top:50%;transform:translateY(-50%);font-size:15rem;opacity:.03;pointer-events:none;line-height:1;">
    <iconify-icon icon="solar:play-circle-bold" style="font-size:15rem;color:var(--accent);"></iconify-icon>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="reveal d1">
      <span class="badge badge-neu">AXON OUTPUT</span>
    </div>

    <h1 class="reveal d2 mt-5" style="font-size:clamp(2.5rem,5vw,4rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;word-break:keep-all;">
      연구가 영상이 되는 곳
    </h1>

    <p class="reveal d3 mt-4" style="font-size:1.1rem;color:var(--text-dim);word-break:keep-all;max-width:560px;">
      코르의 리서치가 애니메이션으로 완성됩니다
    </p>

    <!-- Stats row -->
    <div class="reveal d3 flex flex-wrap items-center gap-4 mt-6">
      <div class="flex items-center gap-2">
        <span style="font-size:1.4rem;font-weight:800;color:var(--accent);">2편</span>
        <span style="font-size:.95rem;color:var(--text-dim);">공개</span>
      </div>
      <div style="width:1px;height:1.2rem;background:var(--divider);"></div>
      <div class="flex items-center gap-2">
        <span style="font-size:1.4rem;font-weight:800;color:var(--text);">25+</span>
        <span style="font-size:.95rem;color:var(--text-dim);">편 제작 중</span>
      </div>
      <div style="width:1px;height:1.2rem;background:var(--divider);"></div>
      <div class="flex items-center gap-2">
        <span style="font-size:1.4rem;font-weight:800;color:var(--text);">10개</span>
        <span style="font-size:.95rem;color:var(--text-dim);">플레이리스트</span>
      </div>
    </div>

    <!-- Kor quote -->
    <blockquote class="reveal d4 mt-8" style="border-left:3px solid var(--accent);padding:.8rem 1.2rem;max-width:600px;background:var(--badge-brain-bg);border-radius:0 10px 10px 0;">
      <p style="font-size:1rem;color:var(--text-dim);line-height:1.75;word-break:keep-all;">
        "영상 하나를 만드는 데 논문 3편 이상, 스크립트 4단계 검토, 그리고 코르의 목소리가 들어갑니다."
      </p>
    </blockquote>
  </div>
</section>

<!-- PLAYLIST FILTER TABS -->
<div style="position:sticky;top:0;z-index:30;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--divider);padding:1rem 0;">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center gap-2 overflow-x-auto" style="scrollbar-width:none;-ms-overflow-style:none;">
      <button class="pl-tab active" data-playlist="전체">전체</button>
      <button class="pl-tab" data-playlist="뇌의 착각">🧠 뇌의 착각</button>
      <button class="pl-tab" data-playlist="뇌 vs AI">🤖 뇌 vs AI</button>
      <button class="pl-tab" data-playlist="뇌의 수면">😴 뇌의 수면</button>
      <button class="pl-tab" data-playlist="마음의 온도">💛 마음의 온도</button>
      <button class="pl-tab" data-playlist="마음의 회복">💊 마음의 회복</button>
    </div>
  </div>
</div>

<!-- PUBLISHED VIDEOS -->
<section style="padding:4rem 0 3rem;">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal flex items-center gap-3 mb-6">
      <h2 style="font-size:1.5rem;font-weight:800;letter-spacing:-.02em;word-break:keep-all;">공개된 영상</h2>
      <span class="badge badge-live">● 공개</span>
    </div>

    <!-- 2-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- VIDEO CARD 1: EP001 -->
      <div class="video-card brain reveal d1" data-playlist="뇌의 착각">
        <!-- Thumbnail -->
        <div class="vthumb" style="background:linear-gradient(135deg,rgba(79,195,247,.15) 0%,rgba(33,150,243,.25) 100%);">
          <!-- Top-left badge -->
          <div style="position:absolute;top:.9rem;left:.9rem;z-index:2;">
            <span class="badge badge-brain">🧠 뇌의 착각</span>
          </div>
          <!-- Bottom-right badge -->
          <div style="position:absolute;bottom:.9rem;right:.9rem;z-index:2;">
            <span class="badge badge-live">공개</span>
          </div>
          <!-- Emoji -->
          <span style="font-size:5rem;line-height:1;user-select:none;">🧫</span>
          <!-- Play overlay -->
          <div class="vplay-btn">
            <div class="vplay-icon">
              <iconify-icon icon="solar:play-bold" style="font-size:1.4rem;color:#0D1B2A;margin-left:3px;"></iconify-icon>
            </div>
          </div>
        </div>
        <!-- Content -->
        <div style="padding:1.2rem;">
          <p style="font-size:.82rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:.45rem;">EP.001</p>
          <h3 style="font-size:1.15rem;font-weight:800;letter-spacing:-.02em;line-height:1.35;word-break:keep-all;margin-bottom:.7rem;">뇌세포 20만 개가 둠을 배웠다</h3>
          <p style="font-size:.92rem;color:var(--text-dim);line-height:1.7;word-break:keep-all;margin-bottom:1rem;">접시 위 뇌세포가 게임을 배웠다. 이건 AI가 인간을 대체한다는 뜻이 아니다. 오히려 인간 뇌가 얼마나 효율적인 계산 시스템인지를 더 선명하게 보여주는 사건이다.</p>
          <!-- Meta row -->
          <div class="flex items-center gap-3 mb-4" style="font-size:.82rem;color:var(--text-dim);">
            <span class="flex items-center gap-1">
              <iconify-icon icon="solar:clock-circle-linear" style="font-size:.95rem;"></iconify-icon>
              6:48
            </span>
            <span style="opacity:.4;">·</span>
            <span>2026.03.17</span>
            <span style="opacity:.4;">·</span>
            <span>논문 4편</span>
          </div>
          <!-- CTA -->
          <a href="https://youtube.com/@뇌와마음사이" target="_blank" class="inline-flex items-center gap-2" style="font-size:.92rem;font-weight:700;color:var(--accent);text-decoration:none;transition:gap .2s;">
            YouTube에서 보기
            <iconify-icon icon="solar:arrow-right-up-linear" style="font-size:1.05rem;"></iconify-icon>
          </a>
        </div>
      </div>

      <!-- VIDEO CARD 2: EP017 -->
      <div class="video-card brain reveal d2" data-playlist="뇌 vs AI">
        <!-- Thumbnail -->
        <div class="vthumb" style="background:linear-gradient(135deg,rgba(79,195,247,.12) 0%,rgba(33,150,243,.22) 100%);">
          <!-- Top-left badge -->
          <div style="position:absolute;top:.9rem;left:.9rem;z-index:2;">
            <span class="badge badge-brain">🤖 뇌 vs AI</span>
          </div>
          <!-- Bottom-right badge -->
          <div style="position:absolute;bottom:.9rem;right:.9rem;z-index:2;">
            <span class="badge badge-live">공개</span>
          </div>
          <!-- Emoji -->
          <span style="font-size:5rem;line-height:1;user-select:none;">🤖</span>
          <!-- Play overlay -->
          <div class="vplay-btn">
            <div class="vplay-icon">
              <iconify-icon icon="solar:play-bold" style="font-size:1.4rem;color:#0D1B2A;margin-left:3px;"></iconify-icon>
            </div>
          </div>
        </div>
        <!-- Content -->
        <div style="padding:1.2rem;">
          <p style="font-size:.82rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:.45rem;">EP.017</p>
          <h3 style="font-size:1.15rem;font-weight:800;letter-spacing:-.02em;line-height:1.35;word-break:keep-all;margin-bottom:.7rem;">AI가 생각을 대신해줄수록</h3>
          <p style="font-size:.92rem;color:var(--text-dim);line-height:1.7;word-break:keep-all;margin-bottom:1rem;">Google Effect, Brain Drain, Cognitive Offloading. 세 편의 논문이 말하는 것 — 뇌가 망가진 게 아니라, 더 빠른 경로에 최적화된 것이다.</p>
          <!-- Meta row -->
          <div class="flex items-center gap-3 mb-4" style="font-size:.82rem;color:var(--text-dim);">
            <span class="flex items-center gap-1">
              <iconify-icon icon="solar:clock-circle-linear" style="font-size:.95rem;"></iconify-icon>
              7:12
            </span>
            <span style="opacity:.4;">·</span>
            <span>2026.03.19</span>
            <span style="opacity:.4;">·</span>
            <span>논문 3편</span>
          </div>
          <!-- CTA -->
          <a href="https://youtube.com/@뇌와마음사이" target="_blank" class="inline-flex items-center gap-2" style="font-size:.92rem;font-weight:700;color:var(--accent);text-decoration:none;transition:gap .2s;">
            YouTube에서 보기
            <iconify-icon icon="solar:arrow-right-up-linear" style="font-size:1.05rem;"></iconify-icon>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- COMING SOON GRID -->
<section style="padding:3rem 0 5rem;">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="reveal flex flex-col sm:flex-row sm:items-center gap-3 mb-2">
      <div class="flex items-center gap-3">
        <h2 style="font-size:1.5rem;font-weight:800;letter-spacing:-.02em;word-break:keep-all;">준비 중인 영상</h2>
        <span class="badge badge-soon">제작 중</span>
      </div>
    </div>
    <p class="reveal d1 mb-7" style="font-size:.95rem;color:var(--text-dim);word-break:keep-all;">연구 노트가 완성되면 순서대로 영상이 됩니다</p>

    <!-- 3-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

      <!-- SOON CARD 1 -->
      <div class="soon-card reveal d1" data-playlist="뇌의 수면">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">😴</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.002</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-brain" style="font-size:.68rem;padding:.2rem .65rem;">뇌의 수면</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">왜 피곤한데도 잠이 안 올까</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>리서치 완료</span>
        </div>
      </div>

      <!-- SOON CARD 2 -->
      <div class="soon-card reveal d2" data-playlist="마음의 회복">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">🔋</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.003</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-mind" style="font-size:.68rem;padding:.2rem .65rem;">마음의 회복</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">왜 쉬어도 회복되지 않을까</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>스크립트 작성 중</span>
        </div>
      </div>

      <!-- SOON CARD 3 -->
      <div class="soon-card reveal d3" data-playlist="마음의 온도">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">💛</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.006</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-mind" style="font-size:.68rem;padding:.2rem .65rem;">마음의 온도</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">매력은 얼굴보다 신호다</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>리서치 완료</span>
        </div>
      </div>

      <!-- SOON CARD 4 -->
      <div class="soon-card reveal d1" data-playlist="뇌의 훈련">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">📝</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.005</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-neu" style="font-size:.68rem;padding:.2rem .65rem;">뇌의 훈련</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">왜 시험장만 가면 머리가 하얘질까</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>스크립트 작성 중</span>
        </div>
      </div>

      <!-- SOON CARD 5 -->
      <div class="soon-card reveal d2" data-playlist="뇌의 훈련">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">📚</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.004</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-neu" style="font-size:.68rem;padding:.2rem .65rem;">뇌의 훈련</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">왜 복습할수록 기억이 남을까</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>리서치 완료</span>
        </div>
      </div>

      <!-- SOON CARD 6 -->
      <div class="soon-card reveal d3" data-playlist="마음의 온도">
        <div class="flex items-start justify-between mb-3">
          <span style="font-size:2.5rem;line-height:1;user-select:none;">💛</span>
          <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;letter-spacing:.04em;opacity:.7;">EP.011</span>
        </div>
        <div class="mb-2">
          <span class="badge badge-mind" style="font-size:.68rem;padding:.2rem .65rem;">마음의 온도</span>
        </div>
        <h3 style="font-size:1.05rem;font-weight:700;letter-spacing:-.02em;line-height:1.4;word-break:keep-all;margin-top:.6rem;margin-bottom:.75rem;">왜 사과를 받아도 마음은 바로 안 풀릴까</h3>
        <div class="flex items-center gap-2" style="font-size:.82rem;color:var(--text-dim);">
          <span class="pulse-dot"></span>
          <span>스크립트 작성 중</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- YOUTUBE CTA BANNER -->
<section style="padding:0 0 5rem;">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="reveal" style="background:linear-gradient(135deg,var(--badge-brain-bg) 0%,rgba(33,150,243,.08) 100%);border:1px solid var(--badge-brain-border);border-radius:20px;padding:3rem 2.5rem;text-align:center;">

      <!-- Logo + channel name -->
      <div class="flex items-center justify-center gap-3 mb-5">
        <img src="logo.png" alt="뇌와 마음사이 로고" class="w-12 h-12 object-contain rounded-2xl" style="box-shadow:0 0 0 1.5px rgba(79,195,247,.3);">
        <span style="font-size:1.1rem;font-weight:700;letter-spacing:-.02em;color:var(--text);">뇌와 마음사이</span>
      </div>

      <h2 style="font-size:clamp(1.3rem,3vw,1.8rem);font-weight:800;letter-spacing:-.03em;line-height:1.3;word-break:keep-all;margin-bottom:.9rem;">
        지금 구독하면 EP.002를 가장 먼저 볼 수 있습니다
      </h2>

      <p style="font-size:.95rem;color:var(--text-dim);margin-bottom:1.8rem;word-break:keep-all;">
        @뇌와마음사이 | 인지신경과학 기반 콘텐츠
      </p>

      <a href="https://youtube.com/@뇌와마음사이" target="_blank" class="btn-sub" style="font-size:1.05rem;padding:.75rem 2rem;display:inline-flex;">
        <iconify-icon icon="solar:play-bold" style="font-size:1.05rem;"></iconify-icon>
        유튜브 채널 구독하기
      </a>

      <p style="font-size:.85rem;color:var(--text-dim);margin-top:.85rem;opacity:.7;">
        알림 설정도 꼭 해주세요 ☝️
      </p>

    </div>
  </div>
</section>


</BaseLayout>
