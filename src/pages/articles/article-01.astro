<script is:inline>
  // Reading progress bar
  const progressFill=document.getElementById('progress-fill');
  const currentSectionLabel=document.getElementById('current-section-label');
  const timeRemaining=document.getElementById('time-remaining');
  const dots=document.querySelectorAll('.section-dot');
  const sections=[
    {id:'s-ch1',name:'Ch.1 접시 위 뉴런',dot:0},
    {id:'s-ch2',name:'Ch.2 둠',dot:1},
    {id:'s-ch3',name:'Ch.3 AI',dot:2},
    {id:'s-ch4',name:'Ch.4 뇌',dot:3},
    {id:'s-ch5',name:'Ch.5 비교',dot:4},
    {id:'s-ch6',name:'Ch.6 함의',dot:5}
  ];
  function updateProgress(){
    const articleBody=document.getElementById('article-body');
    if(!articleBody)return;
    const articleTop=articleBody.offsetTop;
    const articleHeight=articleBody.offsetHeight;
    const scrolled=window.scrollY+window.innerHeight/2-articleTop;
    const progress=Math.max(0,Math.min(100,(scrolled/articleHeight)*100));
    if(progressFill)progressFill.style.height=progress+'%';
    const remaining=Math.max(0,Math.round(12*(1-progress/100)));
    if(timeRemaining)timeRemaining.textContent=remaining>0?`약 ${remaining}분`:'완료';
    dots.forEach(d=>d.classList.remove('active'));
    let currentIdx=0;
    sections.forEach((s,i)=>{
      const el=document.getElementById(s.id);
      if(el&&window.scrollY>=el.offsetTop-160)currentIdx=i;
    });
    if(dots[currentIdx])dots[currentIdx].classList.add('active');
    if(currentSectionLabel)currentSectionLabel.textContent=sections[currentIdx].name;
  }
  window.addEventListener('scroll',updateProgress,{passive:true});
  updateProgress();
  dots.forEach((dot,i)=>{
    dot.addEventListener('click',()=>{
      const el=document.getElementById(sections[i]?.id);
      if(el)el.scrollIntoView({behavior:'smooth',block:'start'});
    });
  });

  // Scroll Reveal
  const revealObserver=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){entry.target.classList.add('visible');revealObserver.unobserve(entry.target);}
    });
  },{threshold:0.15,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.reveal,.reveal-left,.reveal-scale').forEach(el=>revealObserver.observe(el));

  // Timeline
  const tlObserver=new IntersectionObserver((entries)=>{
    entries.forEach((entry,i)=>{
      if(entry.isIntersecting){setTimeout(()=>entry.target.classList.add('visible'),i*200);tlObserver.unobserve(entry.target);}
    });
  },{threshold:0.2});
  document.querySelectorAll('.tl-item').forEach(el=>tlObserver.observe(el));

  // Countup
  function animateCountup(el){
    const target=parseInt(el.dataset.target);const suffix=el.dataset.suffix||'';const duration=1800;const start=performance.now();
    function step(now){const elapsed=now-start;const progress=Math.min(elapsed/duration,1);const eased=1-Math.pow(1-progress,3);
      el.textContent=(target>=10000?Math.round(eased*target).toLocaleString():Math.round(eased*target))+suffix;
      if(progress<1)requestAnimationFrame(step);}
    requestAnimationFrame(step);
  }
  const countupObserver=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{if(entry.isIntersecting){entry.target.querySelectorAll('.countup-num').forEach(animateCountup);countupObserver.unobserve(entry.target);}});
  },{threshold:0.5});
  document.querySelectorAll('.countup-row').forEach(el=>countupObserver.observe(el));

  // Bar Chart
  const chartObserver=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{if(entry.isIntersecting){entry.target.querySelectorAll('.bar-fill').forEach(bar=>bar.classList.add('animated'));chartObserver.unobserve(entry.target);}});
  },{threshold:0.3});
  document.querySelectorAll('.bar-chart').forEach(el=>chartObserver.observe(el));
</script>

