---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="뇌세포가 둠을 배웠다 — 뇌와 마음사이" activePage="research">

<style is:global>
  /* ── Reading Progress Bar ── */
  #reading-progress{position:fixed;right:1.5rem;top:50%;transform:translateY(-50%);z-index:50;display:flex;flex-direction:column;align-items:flex-end;gap:.4rem}
  .progress-track{width:8px;height:55vh;max-height:640px;min-height:400px;background:var(--progress-track,rgba(255,255,255,.08));border-radius:100px;position:relative;overflow:visible}
  .progress-fill{width:8px;background:linear-gradient(180deg,var(--accent) 0%,var(--accent-glow) 100%);border-radius:100px;position:absolute;top:0;left:0;transition:height .15s ease;height:0}
  .section-dot{position:absolute;left:50%;transform:translateX(-50%);width:14px;height:14px;border-radius:50%;background:var(--progress-dot,rgba(255,255,255,.12));border:2.5px solid var(--progress-dot-border,rgba(255,255,255,.2));cursor:pointer;transition:all .2s}
  .section-dot.active{background:var(--accent);border-color:var(--accent);box-shadow:0 0 12px var(--accent-glow)}
  .section-dot::after{content:attr(title);position:absolute;right:calc(100% + 10px);top:50%;transform:translateY(-50%);background:var(--bg-card);border:1px solid var(--card-border);border-radius:8px;padding:.3rem .65rem;font-size:.72rem;font-weight:600;color:var(--text);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;box-shadow:0 2px 8px rgba(0,0,0,.1)}
  .section-dot:hover::after{opacity:1}
  .progress-meta{font-size:.72rem;font-weight:600;color:var(--text-muted);text-align:right;white-space:nowrap}
  @media(max-width:1200px){#reading-progress{display:none}}

  /* ── Article Body (longblack style) ── */
  .article-body{font-size:1.05rem;line-height:1.85;letter-spacing:-0.02em;word-break:keep-all;color:var(--text)}
  .article-body p{margin-bottom:1.6rem}
  .article-body h2{font-size:1.85rem;font-weight:800;letter-spacing:-0.03em;line-height:1.35;margin:3.5rem 0 1.4rem;word-break:keep-all}
  .article-body h2 .ch-num{display:block;font-size:.88rem;font-weight:700;color:var(--accent);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem}

  /* ── Paper Citation ── */
  .paper-cite{background:var(--paper-bg,rgba(255,255,255,.03));border:1px solid var(--paper-border,rgba(255,255,255,.08));border-radius:12px;padding:1.1rem 1.25rem;margin:1.2rem 0;cursor:pointer;transition:all .3s ease}
  .paper-cite:hover{border-color:var(--accent);background:var(--quote-bg,rgba(79,195,247,.04))}
  .paper-detail{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1),opacity .3s ease;opacity:0}
  .paper-cite.expanded .paper-detail{max-height:200px;opacity:1;margin-top:.75rem}
  .paper-toggle{font-size:.75rem;color:var(--accent);font-weight:600;margin-top:.5rem;display:inline-flex;align-items:center;gap:.3rem;transition:transform .2s}
  .paper-cite.expanded .paper-toggle iconify-icon{transform:rotate(180deg)}

  /* ── Keyword Highlight ── */
  .kw{color:var(--accent);font-weight:700;border-bottom:2px solid rgba(255,112,67,.2)}

  /* ── Section Divider ── */
  .section-divider{border:none;border-top:1px solid var(--divider);margin:2.5rem 0}

  /* ── Related Cards ── */
  .related-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:14px;padding:1.1rem 1.2rem;text-decoration:none;color:inherit;transition:all .25s ease;display:block}
  .related-card:hover{background:var(--card-hover-bg);border-color:var(--accent);transform:translateY(-2px)}

  /* ── Scroll Reveal ── */
  .reveal{opacity:0;transform:translateY(32px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  .reveal.visible{opacity:1;transform:translateY(0)}
  .reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  .reveal-left.visible{opacity:1;transform:translateX(0)}
  .reveal-scale{opacity:0;transform:scale(.92);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .reveal-scale.visible{opacity:1;transform:scale(1)}

  /* ── Countup Numbers ── */
  .countup-row{display:flex;gap:2rem;flex-wrap:wrap;margin:1.8rem 0 2.2rem;justify-content:center}
  .countup-item{text-align:center;min-width:100px}
  .countup-num{font-size:2.6rem;font-weight:900;letter-spacing:-.04em;color:var(--accent);line-height:1;font-variant-numeric:tabular-nums}
  .countup-label{font-size:.78rem;color:var(--text-dim);margin-top:.35rem;word-break:keep-all}

  /* ── Bar Chart ── */
  .bar-chart{display:flex;align-items:flex-end;gap:3rem;justify-content:center;padding:2rem 0;margin:1.5rem 0 2rem}
  .bar-col{display:flex;flex-direction:column;align-items:center;gap:.6rem}
  .bar-track{width:64px;height:200px;background:var(--progress-track,rgba(255,255,255,.08));border-radius:12px;position:relative;overflow:hidden;display:flex;align-items:flex-end}
  .bar-fill{width:100%;border-radius:12px;transition:height 1.2s cubic-bezier(.16,1,.3,1);height:0}
  .bar-fill.animated{height:var(--target-h)}
  .bar-value{font-size:1.4rem;font-weight:800;color:var(--text);letter-spacing:-.02em}
  .bar-label{font-size:.82rem;color:var(--text-dim);word-break:keep-all;text-align:center;max-width:90px}

  /* ── Timeline ── */
  .timeline{position:relative;padding:2rem 0;margin:2rem 0}
  .timeline::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--accent),var(--accent-glow),transparent);transform:translateX(-50%)}
  .tl-item{position:relative;display:flex;align-items:center;margin-bottom:2rem;opacity:0;transform:translateY(20px);transition:all .6s cubic-bezier(.16,1,.3,1)}
  .tl-item.visible{opacity:1;transform:translateY(0)}
  .tl-item:nth-child(odd){justify-content:flex-start;padding-right:55%}
  .tl-item:nth-child(even){justify-content:flex-end;padding-left:55%}
  .tl-dot{position:absolute;left:50%;transform:translateX(-50%);width:14px;height:14px;border-radius:50%;background:var(--accent);border:3px solid var(--bg-deep);z-index:2;box-shadow:0 0 12px var(--accent-glow)}
  .tl-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:12px;padding:1rem 1.2rem;max-width:260px}
  .tl-year{font-size:1.1rem;font-weight:800;color:var(--accent);margin-bottom:.25rem}
  .tl-desc{font-size:.88rem;color:var(--text-dim);line-height:1.55;word-break:keep-all}
  @media(max-width:640px){.timeline::before{left:20px}.tl-item,.tl-item:nth-child(odd),.tl-item:nth-child(even){justify-content:flex-start;padding-right:0;padding-left:48px}.tl-dot{left:20px}}

  /* ── Compare Table ── */
  .compare-table{width:100%;border-collapse:separate;border-spacing:0;margin:1.5rem 0 2rem;border-radius:12px;overflow:hidden;border:1px solid var(--card-border)}
  .compare-table th{background:var(--paper-bg,rgba(255,255,255,.03));font-size:.78rem;font-weight:700;letter-spacing:.04em;color:var(--text-dim);padding:.75rem 1rem;text-align:left;border-bottom:1px solid var(--divider)}
  .compare-table td{padding:.65rem 1rem;font-size:.9rem;color:var(--text);border-bottom:1px solid var(--divider);line-height:1.5}
  .compare-table tr:last-child td{border-bottom:none}
  .compare-table .brain-col{color:var(--brain);font-weight:600}
  .compare-table .ai-col{color:var(--alert);font-weight:600}

  /* ── Image Slot ── */
  .img-slot{width:100%;border-radius:16px;overflow:hidden;margin:2.5rem 0;position:relative;background:linear-gradient(135deg,rgba(79,195,247,.08),rgba(255,112,67,.06));border:1px dashed var(--card-border);min-height:240px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem}
  .img-slot-label{font-size:.75rem;color:var(--text-muted);font-weight:600;letter-spacing:.05em}
  .img-slot-prompt{font-size:.7rem;color:var(--text-muted);opacity:.6;max-width:400px;text-align:center;line-height:1.5;font-style:italic;padding:0 1rem}
</style>

<!-- READING PROGRESS BAR -->
<div id="reading-progress">
  <span class="progress-meta" style="color:var(--accent);font-weight:700;">읽는 중</span>
  <div class="progress-track">
    <div class="progress-fill" id="progress-fill"></div>
    <div class="section-dot" id="dot-0" style="top:0;" title="Ch.1 접시 위 뉴런"></div>
    <div class="section-dot" id="dot-1" style="top:18%;" title="Ch.2 둠"></div>
    <div class="section-dot" id="dot-2" style="top:36%;" title="Ch.3 AI"></div>
    <div class="section-dot" id="dot-3" style="top:54%;" title="Ch.4 뇌"></div>
    <div class="section-dot" id="dot-4" style="top:72%;" title="Ch.5 비교"></div>
    <div class="section-dot" id="dot-5" style="top:90%;" title="Ch.6 함의"></div>
  </div>
  <span id="current-section-label" class="progress-meta" style="color:var(--accent);">Ch.1 접시 위 뉴런</span>
  <span id="time-remaining" class="progress-meta">약 12분</span>
</div>

<!-- BANNER IMAGE -->
<div style="width:100%;max-height:420px;overflow:hidden;margin-top:4.5rem;">
  <img src={`${base}images/art01/banner.png`} alt="접시 위 뇌세포" style="width:100%;height:auto;object-fit:cover;display:block;">
</div>

<!-- ARTICLE HERO -->
<section style="padding-top:3rem;padding-bottom:3rem;">
  <div class="max-w-3xl mx-auto px-6">

    <!-- Breadcrumb -->
    <p style="font-size:.85rem;color:var(--text-dim);margin-bottom:1.25rem;">
      <a href="research.html" style="color:var(--text-dim);text-decoration:none;transition:color .2s;"
         onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-dim)'">연구</a>
      <span style="margin:0 .4rem;opacity:.5;">›</span>
      <span>🤖 뇌, AI랑 다를까요?</span>
    </p>

    <!-- Badge -->
    <div style="margin-bottom:1.25rem;">
      <span class="badge badge-brain">🤖 뇌, AI랑 다를까요?</span>
    </div>

    <!-- H1 -->
    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;line-height:1.18;word-break:keep-all;margin-bottom:1rem;">
      사람의 뇌는 AI보다 뛰어난 걸까?
    </h1>

    <!-- Subtitle -->
    <p style="font-size:1.15rem;color:var(--text-dim);line-height:1.6;word-break:keep-all;margin-bottom:0;">
      접시 위 뉴런 20만 개가 둠을 플레이한 날, 떠오른 질문
    </p>

    <!-- Meta row -->
    <div style="display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--divider);">
      <span style="display:inline-flex;align-items:center;gap:.4rem;font-size:.9rem;color:var(--text-dim);">
        <iconify-icon icon="solar:user-circle-linear" style="font-size:1rem;color:var(--accent);"></iconify-icon>코르
      </span>
      <span style="display:inline-flex;align-items:center;gap:.4rem;font-size:.9rem;color:var(--text-dim);">
        <iconify-icon icon="solar:calendar-linear" style="font-size:1rem;"></iconify-icon>2026.03.21
      </span>
      <span style="display:inline-flex;align-items:center;gap:.4rem;font-size:.9rem;color:var(--text-dim);">
        <iconify-icon icon="solar:clock-circle-linear" style="font-size:1rem;"></iconify-icon>읽기 약 12분
      </span>
      <span style="display:inline-flex;align-items:center;gap:.4rem;font-size:.9rem;color:var(--text-dim);">
        <iconify-icon icon="solar:document-text-linear" style="font-size:1rem;color:var(--mind);"></iconify-icon>논문 3편
      </span>
    </div>

  </div>
</section>

<!-- ARTICLE BODY -->
<article id="article-body" class="article-body max-w-3xl mx-auto px-6" style="padding:3rem 0 5rem;">

  <!-- Hero Image Slot -->
  <div class="reveal-scale" style="margin:2.5rem 0;border-radius:16px;overflow:hidden;">
    <img src={`${base}images/art01/hero.png`} alt="접시 위 뉴런 삽화" style="width:100%;height:auto;display:block;">
  </div>

  <!-- ═══════════ Chapter 1 ═══════════ -->
  <section id="s-ch1">
    <h2 class="reveal"><span class="ch-num">Chapter 1.</span>접시 위 뉴런이 게임을 시작했다</h2>
    <p class="reveal">이야기는 2022년으로 거슬러 올라갑니다.</p>
    <p class="reveal">호주의 <span class="kw">코티컬랩스(Cortical Labs)</span>라는 회사가 인간 줄기세포에서 뉴런을 키워냈습니다. 그리고 <span class="kw">다전극 배열(MEA)</span>, 뉴런이 쏘는 전기 신호를 동시에 읽고 쓸 수 있는 칩 위에 올렸습니다. 이 칩을 통해 퐁(Pong) 게임 환경을 전기 신호로 뉴런에게 전달한 거죠.</p>
    <p class="reveal">뉴런은 <strong style="color:var(--accent);font-size:1.2em;">5분</strong> 만에 배우기 시작했습니다.</p>
    <p class="reveal">비밀은 피드백 방식에 있었습니다. 공을 맞추면 예측 가능한 전기 자극을 보냈고 공을 놓치면 무작위 전기 자극을 흘렸거든요. 뉴런은 무작위 자극을 피하는 쪽으로 행동을 바꿨습니다.</p>
    <p class="reveal">보상도 없고, 처벌도 없습니다. <span class="kw">예측 가능한 세계</span>와 <span class="kw">예측 불가능한 세계</span>. 그 차이만으로 뉴런은 움직이기 시작했습니다.</p>
    <p class="reveal">생각해 보면 우리도 비슷하지 않나요? 낯선 도시에 던져지면, 아무도 가르쳐주지 않아도 패턴을 찾으려 합니다. 어느 골목이 안전한지, 어떤 표정이 환영의 신호인지. 접시 위 뉴런도 그랬습니다. 누가 규칙을 알려주지 않았는데도요.</p>

    <div class="paper-cite reveal-left" onclick="this.classList.toggle('expanded')">
      <div style="display:flex;align-items:flex-start;gap:.75rem;">
        <iconify-icon icon="solar:document-text-bold" style="font-size:1.3rem;color:var(--accent);flex-shrink:0;margin-top:.1rem;"></iconify-icon>
        <div>
          <p style="font-size:1rem;font-weight:700;color:var(--text);margin:0 0 .4rem;line-height:1.5;">DishBrain 실험 — 배양 뉴런의 게임 학습</p>
          <p style="font-size:.92rem;color:var(--text-dim);line-height:1.7;margin:0;word-break:keep-all;">인간 줄기세포에서 유래한 뉴런을 다전극 배열(MEA) 위에 배양하고, 퐁 게임 환경을 전기 신호로 전달했다. 공을 맞추면 예측 가능한 자극, 놓치면 무작위 자극을 제공. 뉴런은 5분 내에 학습 징후를 보였으며, 이는 자유 에너지 원리로 해석된다.</p>
          <div class="paper-detail">
            <p style="font-size:.82rem;color:var(--text-muted);line-height:1.6;margin:0;">Kagan, B.J. et al. (2022). "In vitro neurons learn and exhibit sentience when embodied in a simulated game-world." <em>Neuron</em>, 110(23). | Cortical Labs, Australia</p>
          </div>
          <span class="paper-toggle"><iconify-icon icon="solar:alt-arrow-down-linear" style="font-size:.85rem;"></iconify-icon> 출처 보기</span>
        </div>
      </div>
    </div>

    <p class="reveal">퐁은 단순한 게임입니다. 패들을 좌우로 움직여 공을 받아치면 되죠. 그런데 접시 위 뉴런이 이걸 해냈다는 것 자체가 질문을 바꿔버렸습니다. 대뇌피질도, 감각기관도 없는 세포 덩어리가 환경에 적응했으니까요. 생물학적으로 학습이 어떻게 일어나는지, 처음부터 다시 생각해야 했습니다.</p>
    <p class="reveal">이건 시작에 불과했습니다.</p>

    <!-- Countup Numbers -->
    <div class="countup-row reveal-scale">
      <div class="countup-item">
        <div class="countup-num" data-target="200000" data-suffix="">0</div>
        <div class="countup-label">뉴런 수</div>
      </div>
      <div class="countup-item">
        <div class="countup-num" data-target="20" data-suffix="W">0</div>
        <div class="countup-label">뇌 소비 전력</div>
      </div>
      <div class="countup-item">
        <div class="countup-num" data-target="700" data-suffix="W">0</div>
        <div class="countup-label">GPU 소비 전력</div>
      </div>
    </div>
  </section>

  <!-- 🎙️ Podcast -->
  <details class="reveal" style="margin:2rem 0;border:1px solid var(--card-border);border-radius:14px;background:var(--bg-card);overflow:hidden;">
    <summary style="padding:1rem 1.2rem;cursor:pointer;display:flex;align-items:center;gap:.6rem;font-size:.95rem;font-weight:700;color:var(--text);list-style:none;">
      <iconify-icon icon="solar:microphone-3-bold" style="font-size:1.2rem;color:var(--accent);"></iconify-icon>
      🎙️ 이 글을 팟캐스트로 듣기
      <span style="margin-left:auto;font-size:.75rem;color:var(--text-muted);font-weight:500;">NotebookLM Deep Dive</span>
    </summary>
    <div style="padding:0 1.2rem 1.2rem;">
      <p style="font-size:.82rem;color:var(--text-dim);margin-bottom:.8rem;line-height:1.6;">둠 게임 하는 뇌세포와 지능의 본질 — AI 팟캐스트가 이 아티클을 깊이 파헤칩니다.</p>
      <audio controls preload="none" style="width:100%;border-radius:8px;">
        <source src="https://lh3.googleusercontent.com/notebooklm/ANHLwAxLdAMLPneEPCE6vuhcsPmvsu4Ls8ct6Mkzlm1ZOBp7cIl9oFGejpW6Mct5qw4d6NVoIYzKfzulKzOWEI44rVNYoZo6qNQ3nVwX3rvZ1RnP8X-oZ4ZanqZcUYbUTiHBl5P5MjWqU77jErFRx7znjrfgUDKdXZk=m140-dv" type="audio/mp4">
      </audio>
    </div>
  </details>

  <!-- ═══════════ Chapter 2 ═══════════ -->
  <section id="s-ch2">
    <hr class="section-divider">
    <h2 class="reveal"><span class="ch-num">Chapter 2.</span>4년 뒤, 둠을 플레이하다</h2>
    <p class="reveal">2026년 3월, 같은 팀이 <span class="kw">CL1 칩</span>을 공개했습니다.</p>
    <p class="reveal">이번에는 80만 개 뉴런 중 약 20만 개를 깨워서 둠을 플레이했습니다. 퐁의 단순한 좌우 이동과는 비교가 안 됩니다. 3D 공간에서 적을 구별하고 사격 타이밍까지 잡아야 하니까요.</p>
    <p class="reveal">소비 전력은 핸드폰 계산기보다 적었습니다. 지금 이 글을 읽고 있는 당신의 뇌도 비슷한 전력으로 돌아가고 있고요.</p>
    <p class="reveal">여기서 한 발 더 나갔습니다. 같은 뉴런 배양체를 <span class="kw">대형 언어 모델(LLM)</span>, ChatGPT 같은 AI에 연결했습니다. 뉴런이 쏘는 <span class="kw">스파이크</span>(전기 펄스, 뉴런이 '발사!'하고 보내는 짧은 신호)가 다음에 올 단어를 고르는 신호가 되어 텍스트를 만들어낸 겁니다. 살아 있는 뉴런과 실리콘 칩이 함께 계산한 첫 번째 사례였습니다.</p>
    <p class="reveal">솔직해야 할 지점이 있습니다.</p>
    <p class="reveal">아직 피어리뷰(동료 과학자 검증) 논문은 나오지 않았습니다. 학습이 뉴런 자체에서 일어난 건지 보조 소프트웨어가 도운 건지도 논쟁 중이고요. 플레이 수준도 "처음 컴퓨터를 본 초보자" 정도였습니다.</p>

    <div class="kor-quote reveal-left">
      <p style="font-style:italic;font-size:1.05rem;line-height:1.7;word-break:keep-all;">"이 실험은 아직 미완입니다. 하지만 '미완이니까 무시하자'와 '미완이지만 방향은 보인다'는 전혀 다른 태도입니다."</p>
      <p style="font-size:.85rem;color:var(--accent);font-weight:700;margin-top:.75rem;">— 코르</p>
    </div>

    <p class="reveal">중요한 것은 결과의 수준이 아닙니다. 20만 개 뉴런이 3D 환경에 반응하며 행동을 조정했다는 구조 자체입니다.</p>
    <p class="reveal">그렇다면 이 뉴런들의 반대편에 있는 AI는 대체 어떻게 생각하는 걸까요.</p>

