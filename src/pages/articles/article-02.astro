---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="유료 강좌가 당신 뇌를 속이는 5가지 방법 — 뇌와 마음사이" activePage="research">

<style is:global>
  #reading-progress{position:fixed;right:1.5rem;top:50%;transform:translateY(-50%);z-index:50;display:flex;flex-direction:column;align-items:flex-end;gap:.4rem}
  .progress-track{width:8px;height:55vh;max-height:640px;min-height:400px;background:var(--progress-track,rgba(255,255,255,.08));border-radius:100px;position:relative;overflow:visible}
  .progress-fill{width:8px;background:linear-gradient(180deg,var(--accent) 0%,var(--accent-glow) 100%);border-radius:100px;position:absolute;top:0;left:0;transition:height .15s ease;height:0}
  .section-dot{position:absolute;left:50%;transform:translateX(-50%);width:14px;height:14px;border-radius:50%;background:var(--progress-dot,rgba(255,255,255,.12));border:2.5px solid var(--progress-dot-border,rgba(255,255,255,.2));cursor:pointer;transition:all .2s}
  .section-dot.active{background:var(--accent);border-color:var(--accent);box-shadow:0 0 12px var(--accent-glow)}
  .section-dot::after{content:attr(title);position:absolute;right:calc(100% + 10px);top:50%;transform:translateY(-50%);background:var(--bg-card);border:1px solid var(--card-border);border-radius:8px;padding:.3rem .65rem;font-size:.72rem;font-weight:600;color:var(--text);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s;box-shadow:0 2px 8px rgba(0,0,0,.1)}
  .section-dot:hover::after{opacity:1}
  .progress-meta{font-size:.72rem;font-weight:600;color:var(--text-muted);text-align:right;white-space:nowrap}
  @media(max-width:1200px){#reading-progress{display:none}}
  .article-body{font-size:1.05rem;line-height:1.85;letter-spacing:-0.02em;word-break:keep-all;color:var(--text)}
  .article-body p{margin-bottom:1.6rem}
  .article-body h2{font-size:1.85rem;font-weight:800;letter-spacing:-0.03em;line-height:1.35;margin:3.5rem 0 1.4rem;word-break:keep-all}
  .article-body h2 .ch-num{display:block;font-size:.88rem;font-weight:700;color:var(--accent);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem}
  .paper-cite{background:var(--paper-bg,rgba(255,255,255,.03));border:1px solid var(--paper-border,rgba(255,255,255,.08));border-radius:12px;padding:1.1rem 1.25rem;margin:1.2rem 0;cursor:pointer;transition:all .3s ease}
  .paper-cite:hover{border-color:var(--accent);background:var(--quote-bg,rgba(79,195,247,.04))}
  .paper-detail{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.16,1,.3,1),opacity .3s ease;opacity:0}
  .paper-cite.expanded .paper-detail{max-height:200px;opacity:1;margin-top:.75rem}
  .paper-toggle{font-size:.75rem;color:var(--accent);font-weight:600;margin-top:.5rem;display:inline-flex;align-items:center;gap:.3rem}
  .paper-cite.expanded .paper-toggle iconify-icon{transform:rotate(180deg)}
  .kw{color:var(--accent);font-weight:700;border-bottom:2px solid rgba(255,112,67,.2)}
  .section-divider{border:none;border-top:1px solid var(--divider);margin:2.5rem 0}
  .related-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:14px;padding:1.1rem 1.2rem;text-decoration:none;color:inherit;transition:all .25s ease;display:block}
  .related-card:hover{background:var(--card-hover-bg);border-color:var(--accent);transform:translateY(-2px)}
  .reveal{opacity:0;transform:translateY(32px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  .reveal.visible{opacity:1;transform:translateY(0)}
  .reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
  .reveal-left.visible{opacity:1;transform:translateX(0)}
  .reveal-scale{opacity:0;transform:scale(.92);transition:opacity .6s ease,transform .6s cubic-bezier(.16,1,.3,1)}
  .reveal-scale.visible{opacity:1;transform:scale(1)}
  .countup-row{display:flex;gap:2rem;flex-wrap:wrap;margin:1.8rem 0 2.2rem;justify-content:center}
  .countup-item{text-align:center;min-width:100px}
  .countup-num{font-size:2.6rem;font-weight:900;letter-spacing:-.04em;color:var(--accent);line-height:1;font-variant-numeric:tabular-nums}
  .countup-label{font-size:.78rem;color:var(--text-dim);margin-top:.35rem;word-break:keep-all}
  .bar-chart{display:flex;align-items:flex-end;gap:3rem;justify-content:center;padding:2rem 0;margin:1.5rem 0 2rem}
  .bar-col{display:flex;flex-direction:column;align-items:center;gap:.6rem}
  .bar-track{width:64px;height:200px;background:var(--progress-track,rgba(255,255,255,.08));border-radius:12px;position:relative;overflow:hidden;display:flex;align-items:flex-end}
  .bar-fill{width:100%;border-radius:12px;transition:height 1.2s cubic-bezier(.16,1,.3,1);height:0}
  .bar-fill.animated{height:var(--target-h)}
  .bar-value{font-size:1.4rem;font-weight:800;color:var(--text);letter-spacing:-.02em}
  .bar-label{font-size:.82rem;color:var(--text-dim);word-break:keep-all;text-align:center;max-width:90px}
  .compare-table{width:100%;border-collapse:separate;border-spacing:0;margin:1.5rem 0 2rem;border-radius:12px;overflow:hidden;border:1px solid var(--card-border)}
  .compare-table th{background:var(--paper-bg,rgba(255,255,255,.03));font-size:.78rem;font-weight:700;letter-spacing:.04em;color:var(--text-dim);padding:.75rem 1rem;text-align:left;border-bottom:1px solid var(--divider)}
  .compare-table td{padding:.65rem 1rem;font-size:.9rem;color:var(--text);border-bottom:1px solid var(--divider);line-height:1.5}
  .compare-table tr:last-child td{border-bottom:none}
  .img-slot{width:100%;border-radius:16px;overflow:hidden;margin:2.5rem 0;position:relative;background:linear-gradient(135deg,rgba(79,195,247,.08),rgba(255,112,67,.06));border:1px dashed var(--card-border);min-height:240px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.5rem}

  /* ── Funnel Steps ── */
  .funnel-step{display:flex;align-items:center;gap:.85rem;padding:.85rem 1.2rem;margin-bottom:.5rem;border-left:3px solid var(--divider);border-radius:0 12px 12px 0;background:var(--paper-bg);transition:all .5s cubic-bezier(.16,1,.3,1);opacity:0;transform:translateX(-20px)}
  .funnel-step.visible{opacity:1;transform:translateX(0)}
  .funnel-step:hover{border-left-color:var(--accent);background:var(--quote-bg)}
  .funnel-num{display:flex;align-items:center;justify-content:center;width:32px;height:32px;min-width:32px;border-radius:50%;background:var(--accent);color:#fff;font-size:.85rem;font-weight:800;flex-shrink:0}

  /* ── SVG Draw on Scroll ── */
  .svg-draw-path{stroke-dasharray:var(--path-length,1200);stroke-dashoffset:var(--path-length,1200);transition:stroke-dashoffset 2s cubic-bezier(.16,1,.3,1)}
  .svg-draw-path.drawn{stroke-dashoffset:0}
  .svg-draw-dot{opacity:0;transform:scale(0);transition:opacity .4s ease,transform .4s cubic-bezier(.34,1.56,.64,1)}
  .svg-draw-dot.drawn{opacity:1;transform:scale(1)}
  .svg-draw-label{opacity:0;transition:opacity .6s ease .3s}
  .svg-draw-label.drawn{opacity:1}
</style>

<!-- READING PROGRESS BAR -->
<div id="reading-progress">
  <span class="progress-meta" style="color:var(--accent);font-weight:700;">읽는 중</span>
  <div class="progress-track">
    <div class="progress-fill" id="progress-fill"></div>
    <div class="section-dot" id="dot-0" style="top:0;" title="Ch.1 퍼널 설계도"></div>
    <div class="section-dot" id="dot-1" style="top:12%;" title="Ch.2 가용성 편향"></div>
    <div class="section-dot" id="dot-2" style="top:24%;" title="Ch.3 던닝-크루거"></div>
    <div class="section-dot" id="dot-3" style="top:36%;" title="Ch.4 정보 격차"></div>
    <div class="section-dot" id="dot-4" style="top:48%;" title="Ch.5 권위 편향"></div>
    <div class="section-dot" id="dot-5" style="top:60%;" title="Ch.6 매몰 비용"></div>
    <div class="section-dot" id="dot-6" style="top:72%;" title="Ch.7 구조적 문제"></div>
    <div class="section-dot" id="dot-7" style="top:84%;" title="Ch.8 방어법"></div>
    <div class="section-dot" id="dot-8" style="top:96%;" title="Ch.9 파는 쪽"></div>
  </div>
  <span id="current-section-label" class="progress-meta" style="color:var(--accent);">Ch.1 퍼널 설계도</span>
  <span id="time-remaining" class="progress-meta">약 14분</span>
</div>

<!-- BANNER IMAGE -->
<div style="width:100%;max-height:420px;overflow:hidden;margin-top:4.5rem;">
  <img src={`${base}images/art02/banner.png`} alt="유료 강좌와 인지 편향" style="width:100%;height:auto;object-fit:cover;display:block;">
</div>

<!-- ARTICLE HERO -->
<section style="padding-top:3rem;padding-bottom:3rem;">
  <div class="max-w-3xl mx-auto px-6">

    <p style="font-size:.85rem;color:var(--text-dim);margin-bottom:1.25rem;">
      <a href="research.html" style="color:var(--text-dim);text-decoration:none;transition:color .2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-dim)'">연구</a>
      <span style="margin:0 .4rem;opacity:.5;">›</span>
      <span>🧠 뇌가 속는 방법</span>
    </p>

    <div style="margin-bottom:1.25rem;">
      <span class="badge badge-mind">🧠 뇌가 속는 방법</span>
    </div>

    <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;letter-spacing:-.03em;line-height:1.18;word-break:keep-all;margin-bottom:1rem;">
      유료 강좌가 당신 뇌를 속이는<br>5가지 방법
    </h1>

    <p style="font-size:1.15rem;color:var(--text-dim);line-height:1.6;word-break:keep-all;margin-bottom:0;">
      "누구나 월 천만원" 광고를 보면 사고 싶어지는 진짜 이유
    </p>

    <!-- Meta -->
    <div class="flex flex-wrap items-center gap-4 mt-6 pb-6" style="border-bottom:1px solid var(--divider);">
      <span style="font-size:.85rem;color:var(--text-muted);">📄 논문 5편 기반</span>
      <span style="font-size:.85rem;color:var(--text-muted);">⏱ 약 14분</span>
      <span style="font-size:.85rem;color:var(--text-muted);">📅 2026.03.23</span>
    </div>
  </div>
</section>

<!-- ARTICLE BODY -->
<section id="article-body" class="article-body" style="padding-bottom:6rem;">
  <div class="max-w-3xl mx-auto px-6">

    <p class="reveal">유튜브에서 이런 광고를 본 적 있으세요?</p>

    <div class="kor-quote reveal">
      <p style="margin-bottom:0;font-size:1.05rem;line-height:1.8;">"저는 6개월 전까지 평범한 직장인이었습니다. 지금은 월 천만원을 벌고 있습니다. 누구나 할 수 있습니다."</p>
    </div>

    <p class="reveal">혹시 — 잠깐이라도 사고 싶었던 적 있으세요?</p>

    <p class="reveal">그건 당신이 멍청해서가 아닙니다. 그 광고가 당신 뇌의 <span class="kw">인지 편향 5개</span>를 동시에 타격하도록 설계되어 있기 때문입니다.</p>

    <p class="reveal">이 글에서는 유료 강좌 마케팅 퍼널이 뇌의 어떤 편향을 어떤 순서로 공격하는지를 하나씩 따라갑니다. 그리고 끝에서 구체적인 방어법 세 가지를 가져가게 됩니다.</p>

    <div class="reveal-scale" style="margin:2.5rem 0;border-radius:16px;overflow:hidden;">
      <img src={`${base}images/art02/hero.png`} alt="마케팅 퍼널 구조" style="width:100%;height:auto;display:block;">
    </div>

    <hr class="section-divider">

    <!-- Chapter 1 -->
    <h2 id="s-ch1" class="reveal"><span class="ch-num">Chapter 1</span>마케팅 퍼널의 진짜 설계도</h2>

    <p class="reveal">유료 강좌 마케팅은 거의 다 같은 순서를 따릅니다.</p>

    <div class="reveal" style="margin:1.5rem 0 2rem;">
      <div class="funnel-step"><span class="funnel-num">1</span><strong>광고 노출</strong> — 성공 후기 반복 → <span class="kw">가용성 편향</span></div>
      <div class="funnel-step"><span class="funnel-num">2</span><strong>"누구나 가능"</strong> — 자신감 부풀림 → <span class="kw">던닝-크루거</span></div>
      <div class="funnel-step"><span class="funnel-num">3</span><strong>무료 웨비나</strong> — 핵심은 유료에만 → <span class="kw">정보 격차</span></div>
      <div class="funnel-step"><span class="funnel-num">4</span><strong>"지금만 할인"</strong> → 시간 압박 + 충동</div>
      <div class="funnel-step"><span class="funnel-num">5</span><strong>결제</strong> — 빠져나오지 못함 → <span class="kw">매몰 비용</span></div>
      <div class="funnel-step" style="border-color:var(--accent);"><span class="funnel-num" style="background:var(--alert);">∞</span><strong>전 과정</strong> — 검증 없는 권위 → <span class="kw">권위 편향</span></div>
    </div>

    <p class="reveal">편향 하나는 이겨낼 수 있어요. 문제는 이 마케팅이 다섯 개를 동시에 쓴다는 겁니다.</p>

    <p class="reveal" style="font-size:1.25rem;font-weight:700;color:var(--accent);">자, 하나씩 보겠습니다.</p>

    <hr class="section-divider">

    <!-- Chapter 2 -->
    <h2 id="s-ch2" class="reveal"><span class="ch-num">Chapter 2</span>성공 후기 10개를 보면, 뇌는 그게 평균이라고 계산합니다</h2>

    <p class="reveal">인스타 피드를 넘기다 보면 성공 후기가 쏟아집니다. "3개월 만에 퇴사했습니다." "월 500만원 달성." "인생이 바뀌었습니다." 이런 후기가 10개, 20개 반복되면 뇌에 특별한 일이 일어납니다.</p>

    <p class="reveal">Tversky와 Kahneman이 1973년에 밝힌 <span class="kw">가용성 편향(Availability Heuristic)</span>입니다.</p>

    <p class="reveal">사건의 실제 확률이 아니라, 머릿속에 얼마나 쉽게 떠오르는지로 확률을 판단하는 현상. 성공 후기가 10개 반복 노출되면, 뇌는 그게 일반적 결과라고 착각합니다. 실패한 999명은요? 후기를 안 남기니까, 뇌한테는 존재하지 않는 겁니다.</p>

    <div class="reveal-scale" style="margin:2.5rem 0;border-radius:16px;overflow:hidden;">
      <img src={`${base}images/art02/availability.png`} alt="성공 10명 vs 실패 999명" style="width:100%;height:auto;display:block;">
    </div>

    <!-- Countup -->
    <div class="countup-row reveal-scale">
      <div class="countup-item">
        <div class="countup-num" data-target="10">0</div>
        <div class="countup-label">성공 후기 (보이는 것)</div>
      </div>
      <div class="countup-item">
        <div class="countup-num" data-target="999" style="color:var(--text-muted);">0</div>
        <div class="countup-label">실패 사례 (보이지 않는 것)</div>
      </div>
    </div>

    <div class="paper-cite reveal" onclick="this.classList.toggle('expanded')">
      <div style="display:flex;align-items:flex-start;gap:.75rem;">
        <iconify-icon icon="solar:document-text-bold" style="font-size:1.3rem;color:var(--accent);flex-shrink:0;margin-top:.1rem;"></iconify-icon>
        <div>
          <p style="font-size:1rem;font-weight:700;color:var(--text);margin:0 0 .4rem;line-height:1.5;">가용성 편향 — 떠올리기 쉬우면 더 자주 일어난다고 착각한다</p>
          <p style="font-size:.92rem;color:var(--text-dim);line-height:1.7;margin:0;word-break:keep-all;">사건의 실제 빈도가 아니라, 머릿속에 얼마나 쉽게 떠오르는지로 확률을 판단한다. 비행기 사고 뉴스를 본 직후 비행이 더 위험하게 느껴지는 것이 대표적 예시다. 성공 후기가 반복 노출되면 뇌는 그것이 평균적 결과라고 자동 계산한다.</p>
          <div class="paper-detail">
            <p style="font-size:.82rem;color:var(--text-muted);line-height:1.6;margin:0;">Tversky, A. & Kahneman, D. (1973). "Availability: A Heuristic for Judging Frequency and Probability." <em>Cognitive Psychology</em>, 5(2), 207-232.</p>
          </div>
          <span class="paper-toggle"><iconify-icon icon="solar:alt-arrow-down-linear" style="font-size:.85rem;"></iconify-icon> 출처 보기</span>
        </div>
      </div>
    </div>

    <hr class="section-divider">

    <!-- Chapter 3 -->
    <h2 id="s-ch3" class="reveal"><span class="ch-num">Chapter 3</span>"누구나 할 수 있다"가 초보자에게 가장 잘 먹히는 이유</h2>

    <p class="reveal">광고가 확률을 왜곡했다면, 다음 단계는 자신감을 부풀리는 겁니다.</p>

    <p class="reveal">"누구나 할 수 있습니다." "특별한 기술이 필요 없습니다." "저도 처음에는 아무것도 몰랐습니다." 이 말이 왜 초보자에게 유독 강력한지를 설명하는 연구가 있습니다.</p>

    <p class="reveal">1999년, Kruger와 Dunning이 발표한 <span class="kw">던닝-크루거 효과(Dunning-Kruger Effect)</span>.</p>

    <p class="reveal">능력이 낮을수록 자기 능력을 과대평가합니다. <span class="kw">하위 25%가 자기를 상위 40%로 평가</span>했습니다. 핵심은 이중 부담입니다. 능력이 부족하면, 그 부족을 인지할 메타인지도 부족합니다.</p>

    <div class="kor-quote reveal">
      <p style="margin-bottom:0;font-size:1.05rem;line-height:1.8;">"나는 안 속겠지"라고 생각하는 사람이 가장 취약합니다. 속고 있다는 걸 모르니까요.</p>
    </div>

    <!-- 던닝-크루거 곡선 — HTML/CSS 인포그래픽 -->
    <div class="reveal-scale" style="margin:2.5rem 0;padding:2rem 1.5rem;background:var(--paper-bg);border:1px solid var(--paper-border);border-radius:16px;">
      <p style="font-size:.75rem;font-weight:700;color:var(--text-muted);letter-spacing:.06em;text-transform:uppercase;margin-bottom:1.2rem;text-align:center;">던닝-크루거 효과 — 자기 평가 vs 실제 능력</p>
      <div style="position:relative;width:100%;max-width:520px;margin:0 auto;height:280px;">
        <!-- Y축 -->
        <div style="position:absolute;left:0;top:0;bottom:30px;width:1px;background:var(--divider);"></div>
        <span style="position:absolute;left:-2px;top:0;font-size:.65rem;color:var(--text-muted);transform:translateX(-100%);padding-right:6px;white-space:nowrap;">높음</span>
        <span style="position:absolute;left:-2px;bottom:30px;font-size:.65rem;color:var(--text-muted);transform:translateX(-100%);padding-right:6px;white-space:nowrap;">낮음</span>
        <span style="position:absolute;left:-40px;top:50%;font-size:.68rem;color:var(--text-dim);font-weight:600;transform:rotate(-90deg) translateX(-50%);transform-origin:center;white-space:nowrap;">자기 평가</span>
        <!-- X축 -->
        <div style="position:absolute;left:0;right:0;bottom:30px;height:1px;background:var(--divider);"></div>
        <span style="position:absolute;left:8px;bottom:10px;font-size:.65rem;color:var(--text-muted);">초보</span>
