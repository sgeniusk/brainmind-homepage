---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="코르 소개 — 뇌와 마음사이" activePage="about" footerVariant="full">
  <style>
    @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    .float{animation:float 4s ease-in-out infinite}
    @keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}
    .pdot{animation:pulse-dot 2.2s ease-in-out infinite}

    .kor-quote{padding:1.4rem 1.7rem;border-left:3px solid var(--accent);background:var(--badge-brain-bg);border-radius:0 12px 12px 0}
    .kor-quote.mind{border-left-color:var(--mind);background:rgba(255,213,79,.04)}

    /* Timeline */
    .timeline-item{display:flex;gap:1.5rem;padding-bottom:2.5rem;position:relative}
    .timeline-item:not(:last-child)::before{content:'';position:absolute;left:19px;top:40px;bottom:0;width:1px;background:linear-gradient(180deg,rgba(79,195,247,.3),rgba(79,195,247,.05))}
    .timeline-dot{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.15rem;border:2px solid}
    .timeline-dot.brain{background:var(--badge-brain-bg);border-color:rgba(79,195,247,.4)}
    .timeline-dot.mind{background:var(--badge-mind-bg);border-color:rgba(255,213,79,.4)}
    /* Lab cards */
    .lab-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:14px;padding:1.25rem;transition:all .25s ease}
    .lab-card:hover{background:var(--card-hover-bg);transform:translateY(-2px)}
    /* Trait cards */
    .trait-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:13px;padding:1.2rem;transition:background .35s ease,border-color .35s ease}
    /* Philosophy card */
    .phil-card{border-radius:16px;padding:2rem;flex:1;min-width:0;transition:background .35s ease,border-color .35s ease}
    .phil-brain{background:rgba(79,195,247,.06);border:1px solid rgba(79,195,247,.18)}
    .phil-mind{background:rgba(255,213,79,.05);border:1px solid rgba(255,213,79,.18)}
    .phil-alert{background:rgba(255,112,67,.05);border:1px solid rgba(255,112,67,.18)}
    /* Hero visual card */
    .hero-visual{background:linear-gradient(135deg,rgba(79,195,247,.06) 0%,rgba(230,228,220,.6) 50%,rgba(255,213,79,.05) 100%);border:1px solid rgba(79,195,247,.12);transition:background .35s ease,border-color .35s ease}
    [data-theme="science"] .hero-visual{background:linear-gradient(135deg,rgba(79,195,247,.08) 0%,rgba(26,26,62,.6) 50%,rgba(255,213,79,.06) 100%);border-color:rgba(79,195,247,.15)}
    /* Brain side card */
    .brain-side{background:rgba(79,195,247,.04);border:1px solid rgba(79,195,247,.12);transition:background .35s ease,border-color .35s ease}
    [data-theme="science"] .brain-side{background:rgba(79,195,247,.05);border-color:rgba(79,195,247,.15)}
    /* Mind side card */
    .mind-side{background:rgba(255,213,79,.03);border:1px solid rgba(255,213,79,.12);transition:background .35s ease,border-color .35s ease}
    [data-theme="science"] .mind-side{background:rgba(255,213,79,.04);border-color:rgba(255,213,79,.15)}
    /* Bridge center */
    .bridge-dash{background:repeating-linear-gradient(180deg,rgba(0,0,0,.12) 0,rgba(0,0,0,.12) 4px,transparent 4px,transparent 8px)}
    [data-theme="science"] .bridge-dash{background:repeating-linear-gradient(180deg,rgba(255,255,255,.18) 0,rgba(255,255,255,.18) 4px,transparent 4px,transparent 8px)}
    /* Kor center badge */
    .kor-bridge-badge{background:rgba(255,255,255,.7);border:2px solid rgba(79,195,247,.3);transition:background .35s ease}
    [data-theme="science"] .kor-bridge-badge{background:linear-gradient(135deg,rgba(79,195,247,.2),rgba(255,213,79,.15))}
    /* Between text */
    .between-text{color:rgba(107,107,128,.3)}
    [data-theme="science"] .between-text{color:rgba(200,196,216,.35)}
    /* Kor center badge in hero */
    .kor-hero-badge{background:rgba(255,255,255,.7);border:1px solid rgba(79,195,247,.2);transition:background .35s ease,border-color .35s ease}
    [data-theme="science"] .kor-hero-badge{background:rgba(13,27,42,.7);border-color:rgba(79,195,247,.2)}
    /* Hero glow */
    .hero-title-glow{text-shadow:0 0 20px rgba(79,195,247,.25)}
    [data-theme="science"] .hero-title-glow{text-shadow:0 0 40px rgba(79,195,247,.6)}
    /* Signature glow */
    .sig-glow{text-shadow:0 0 15px rgba(79,195,247,.15)}
    [data-theme="science"] .sig-glow{text-shadow:0 0 30px rgba(79,195,247,.3)}
    /* Stat pills in hero */
    .stat-pill{display:flex;align-items:center;gap:.5rem;padding:.5rem 1rem;border-radius:100px;transition:background .35s ease,border-color .35s ease}
    .stat-pill-brain{background:rgba(79,195,247,.06);border:1px solid rgba(79,195,247,.12)}
    [data-theme="science"] .stat-pill-brain{background:rgba(79,195,247,.06);border-color:rgba(79,195,247,.15)}
    .stat-pill-neu{background:rgba(107,107,128,.04);border:1px solid rgba(107,107,128,.1)}
    [data-theme="science"] .stat-pill-neu{background:rgba(200,196,216,.05);border-color:rgba(200,196,216,.13)}
    /* Trait icon boxes */
    .trait-icon-brain{background:rgba(79,195,247,.08);border:1px solid rgba(79,195,247,.15)}
    [data-theme="science"] .trait-icon-brain{background:rgba(79,195,247,.1);border-color:rgba(79,195,247,.2)}
    .trait-icon-mind{background:rgba(255,213,79,.06);border:1px solid rgba(255,213,79,.15)}
    [data-theme="science"] .trait-icon-mind{background:rgba(255,213,79,.08);border-color:rgba(255,213,79,.2)}
    .trait-icon-neu{background:rgba(107,107,128,.06);border:1px solid rgba(107,107,128,.12)}
    [data-theme="science"] .trait-icon-neu{background:rgba(200,196,216,.07);border-color:rgba(200,196,216,.15)}
    /* Logo outline glow */
    .logo-glow{box-shadow:0 0 15px rgba(79,195,247,.1);border:1px solid rgba(79,195,247,.1)}
    [data-theme="science"] .logo-glow{box-shadow:0 0 30px rgba(79,195,247,.2);border-color:rgba(79,195,247,.15)}
    /* Brain/mind tag pills */
    .tag-brain{padding:.25rem .7rem;border-radius:100px;font-size:.75rem;font-weight:700;background:var(--badge-brain-bg);border:1px solid var(--badge-brain-border);color:var(--brain)}
    .tag-mind{padding:.25rem .7rem;border-radius:100px;font-size:.75rem;font-weight:700;background:var(--badge-mind-bg);border:1px solid var(--badge-mind-border);color:var(--mind)}
  </style>

<!-- SECTION 1: HERO -->
<section style="background:var(--bg-deep);padding:7rem 0 4rem;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-14">

      <!-- LEFT: Text -->
      <div style="flex:0 0 55%;" class="reveal">
        <div class="mb-5">
          <span class="badge badge-neu">독립 인지신경과학자</span>
        </div>
        <h1 class="hero-title-glow" style="font-size:clamp(4rem,10vw,7rem);font-weight:900;letter-spacing:-.05em;color:var(--accent);line-height:1;margin-bottom:.5rem;word-break:keep-all;">
          코르
        </h1>
        <p style="font-size:1.25rem;color:var(--text-dim);letter-spacing:.02em;margin-bottom:1.2rem;font-style:italic;">
          Kor. Between Brain and Mind.
        </p>
        <p style="font-size:1.1rem;line-height:1.75;color:var(--text);margin-bottom:2rem;word-break:keep-all;">
          42세. 서울 마포구 독립 연구자.<br>뇌와 마음의 경계를 번역합니다.
        </p>

        <div class="flex flex-wrap gap-4 mb-2.5" style="margin-bottom:2rem;">
          <div class="stat-pill stat-pill-brain">
            <span style="font-size:.8rem;color:var(--accent);font-weight:700;letter-spacing:.04em;">10년 연구</span>
          </div>
          <div class="stat-pill stat-pill-neu">
            <iconify-icon icon="solar:map-point-linear" style="font-size:.9rem;color:var(--text-dim);"></iconify-icon>
            <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;">서울 마포구</span>
          </div>
          <div class="stat-pill stat-pill-neu">
            <iconify-icon icon="solar:diploma-linear" style="font-size:.9rem;color:var(--text-dim);"></iconify-icon>
            <span style="font-size:.8rem;color:var(--text-dim);font-weight:600;">SNU · KAIST · UCSD</span>
          </div>
        </div>

        <div class="kor-quote">
          <p style="font-size:1rem;line-height:1.8;color:var(--text);word-break:keep-all;">
            "10년 동안 논문을 썼습니다. 아무도 읽지 않았습니다.<br>
            뇌과학은 실험실 밖으로 나와야 했습니다."
          </p>
          <p style="font-size:.8rem;color:var(--accent);font-weight:700;letter-spacing:.05em;margin-top:.7rem;">— 코르</p>
        </div>
      </div>

      <!-- RIGHT: Kor visual -->
      <div style="flex:0 0 45%;" class="reveal d2">
        <div class="hero-visual" style="position:relative;border-radius:24px;padding:2.5rem;aspect-ratio:4/5;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;">
          <img src={`${base}assets/kor_master.png`} alt="코르" class="float"
               style="width:75%;max-width:280px;object-fit:contain;position:relative;z-index:1;filter:drop-shadow(0 8px 24px rgba(0,0,0,.15));margin-bottom:1rem;">
          <p style="font-size:.82rem;color:var(--text-dim);letter-spacing:.04em;text-align:center;position:relative;z-index:1;word-break:keep-all;">
            코르의 연구소 / 서울 마포구
          </p>
          <div style="position:absolute;bottom:1.8rem;left:1.5rem;right:1.5rem;display:flex;align-items:center;gap:.75rem;">
            <div style="display:flex;align-items:center;gap:.4rem;flex-shrink:0;">
              <div class="pdot" style="width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent-glow);"></div>
              <span style="font-size:.72rem;font-weight:700;color:var(--accent);letter-spacing:.06em;">BRAIN</span>
            </div>
            <div style="flex:1;height:1px;background:linear-gradient(90deg,rgba(79,195,247,.4),rgba(255,213,79,.4));"></div>
            <div class="kor-hero-badge" style="flex-shrink:0;padding:.25rem .65rem;border-radius:100px;font-size:.72rem;font-weight:800;color:var(--text);letter-spacing:.04em;">코르</div>
            <div style="flex:1;height:1px;background:linear-gradient(90deg,rgba(255,213,79,.4),rgba(79,195,247,.4));"></div>
            <div style="display:flex;align-items:center;gap:.4rem;flex-shrink:0;">
              <span style="font-size:.72rem;font-weight:700;color:var(--mind);letter-spacing:.06em;">MIND</span>
              <div class="pdot" style="width:8px;height:8px;border-radius:50%;background:var(--mind);box-shadow:0 0 8px rgba(255,213,79,.5);animation-delay:.8s;"></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- SECTION 2: 두 세계 사이 -->
<section style="background:var(--bg-mid);padding:5rem 0;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <h2 style="font-size:clamp(1.8rem,4vw,2.5rem);font-weight:900;letter-spacing:-.04em;margin-bottom:.85rem;word-break:keep-all;">두 세계 사이에서</h2>
      <p style="font-size:1.1rem;color:var(--text-dim);word-break:keep-all;">코르는 과학과 감성, 두 세계의 언어를 동시에 씁니다</p>
    </div>
    <div class="flex flex-col md:flex-row gap-6 items-stretch">
      <div class="reveal d1 brain-side" style="flex:1;border-radius:20px;padding:2rem;display:flex;flex-direction:column;align-items:flex-start;">
        <div style="font-size:2.8rem;margin-bottom:.8rem;">🧠</div>
        <h3 style="font-size:3rem;font-weight:900;color:var(--accent);line-height:1;margin-bottom:1.2rem;letter-spacing:-.04em;">뇌</h3>
        <ul style="display:flex;flex-direction:column;gap:.65rem;margin-bottom:1.5rem;flex:1;">
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>인지신경과학</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>피어리뷰 논문</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>실험 데이터</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>신경 메커니즘</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;"></span>계산 시스템으로의 뇌</li>
        </ul>
        <div class="flex flex-wrap gap-2"><span class="tag-brain">Science</span><span class="tag-brain">Data</span><span class="tag-brain">Evidence</span></div>
      </div>

      <div class="reveal d2" style="flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1rem 0.5rem;min-width:90px;gap:.5rem;">
        <div class="bridge-dash" style="width:1px;height:40px;"></div>
        <iconify-icon icon="solar:alt-arrow-down-linear" style="font-size:1.05rem;color:var(--text-dim);"></iconify-icon>
        <div class="kor-bridge-badge" style="width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 0 20px var(--accent-glow);overflow:hidden;">
          <img src={`${base}assets/kor_explaining.png`} alt="코르" style="width:100%;height:100%;object-fit:cover;object-position:top;">
        </div>
        <iconify-icon icon="solar:alt-arrow-up-linear" style="font-size:1.05rem;color:var(--text-dim);"></iconify-icon>
        <div class="between-text" style="writing-mode:vertical-rl;font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:.3rem 0;">BETWEEN</div>
        <iconify-icon icon="solar:alt-arrow-down-linear" style="font-size:1.05rem;color:var(--text-dim);"></iconify-icon>
        <p style="font-size:.78rem;color:var(--text-dim);font-style:italic;text-align:center;margin-top:.3rem;">번역자</p>
        <div class="bridge-dash" style="width:1px;height:40px;"></div>
      </div>

      <div class="reveal d3 mind-side" style="flex:1;border-radius:20px;padding:2rem;display:flex;flex-direction:column;align-items:flex-start;">
        <div style="font-size:2.8rem;margin-bottom:.8rem;">💛</div>
        <h3 style="font-size:3rem;font-weight:900;color:var(--mind);line-height:1;margin-bottom:1.2rem;letter-spacing:-.04em;">마음</h3>
        <ul style="display:flex;flex-direction:column;gap:.65rem;margin-bottom:1.5rem;flex:1;">
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--mind);flex-shrink:0;"></span>심리학</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--mind);flex-shrink:0;"></span>인간의 감정</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--mind);flex-shrink:0;"></span>관계와 연결</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--mind);flex-shrink:0;"></span>경험과 의미</li>
          <li style="display:flex;align-items:center;gap:.6rem;font-size:.95rem;color:var(--text);word-break:keep-all;"><span style="width:6px;height:6px;border-radius:50%;background:var(--mind);flex-shrink:0;"></span>해석으로서의 마음</li>
        </ul>
        <div class="flex flex-wrap gap-2"><span class="tag-mind">Emotion</span><span class="tag-mind">Meaning</span><span class="tag-mind">Human</span></div>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 3: 코르의 여정 -->
<section style="background:var(--bg-deep);padding:5rem 0;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12 reveal">
      <h2 style="font-size:clamp(1.8rem,4vw,2.5rem);font-weight:900;letter-spacing:-.04em;margin-bottom:.85rem;word-break:keep-all;">코르의 여정</h2>
      <p style="font-size:1.05rem;color:var(--text-dim);word-break:keep-all;">실험실에서 독립 연구소까지</p>
    </div>
    <div class="max-w-2xl mx-auto">
      <div class="timeline-item reveal d1">
        <div class="timeline-dot brain">🎓</div>
        <div style="flex:1;padding-top:.35rem;">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap;"><span style="font-size:.8rem;font-weight:700;color:var(--text-dim);font-variant-numeric:tabular-nums;">2002–2006</span><span class="badge badge-brain">서울대학교</span></div>
          <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);margin-bottom:.6rem;word-break:keep-all;">심리학과 학사</h3>
          <p style="font-size:.95rem;line-height:1.8;color:var(--text-dim);word-break:keep-all;">처음엔 사람의 마음을 이해하고 싶었습니다. 심리학이 그 문을 열어줄 것이라 믿었습니다. 그런데 공부할수록 뇌에 대한 질문이 더 커졌습니다.</p>
        </div>
      </div>
      <div class="timeline-item reveal d1">
        <div class="timeline-dot brain">🔬</div>
        <div style="flex:1;padding-top:.35rem;">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap;"><span style="font-size:.8rem;font-weight:700;color:var(--text-dim);">2006–2008</span><span class="badge badge-brain">KAIST</span></div>
          <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);margin-bottom:.6rem;word-break:keep-all;">뇌인지과학 석사</h3>
          <p style="font-size:.95rem;line-height:1.8;color:var(--text-dim);word-break:keep-all;">뇌를 직접 들여다보기 시작했습니다. fMRI 데이터, 뉴런 기록, 인지 실험. 과학은 정밀했지만, 인간은 더 복잡했습니다.</p>
        </div>
      </div>
      <div class="timeline-item reveal d2">
        <div class="timeline-dot brain">✈️</div>
        <div style="flex:1;padding-top:.35rem;">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap;"><span style="font-size:.8rem;font-weight:700;color:var(--text-dim);">2009–2014</span><span class="badge badge-brain">UC San Diego</span></div>
          <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);margin-bottom:.6rem;word-break:keep-all;">신경과학 박사</h3>
          <p style="font-size:.95rem;line-height:1.8;color:var(--text-dim);word-break:keep-all;">미국으로 건너가 5년을 보냈습니다. 논문 7편, 학회 발표 12회. 그런데 연구실 밖에서 아무도 이 내용을 알지 못했습니다. 뭔가 잘못됐다는 생각이 들었습니다.</p>
        </div>
      </div>
      <div class="timeline-item reveal d3">
        <div class="timeline-dot mind">🏠</div>
        <div style="flex:1;padding-top:.35rem;">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;flex-wrap:wrap;"><span style="font-size:.8rem;font-weight:700;color:var(--text-dim);">2024–현재</span><span class="badge badge-mind">서울 마포구</span></div>
          <h3 style="font-size:1.15rem;font-weight:800;color:var(--text);margin-bottom:.6rem;word-break:keep-all;">독립 연구자 · 창작자</h3>
