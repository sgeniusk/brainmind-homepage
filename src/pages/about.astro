---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="소개 — 뇌와 마음사이" activePage="about">
  <section style="padding:9rem 0 5rem;">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="reveal" style="font-size:clamp(2.2rem,5vw,3.2rem);font-weight:900;letter-spacing:-.04em;line-height:1.2;word-break:keep-all;margin-bottom:1.5rem;">
        뇌와 마음사이
      </h1>
      <p class="reveal d1" style="font-size:1.1rem;color:var(--text-dim);line-height:1.85;word-break:keep-all;">
        테스트 페이지입니다. Astro 마이그레이션 확인용.
      </p>
    </div>
  </section>
</BaseLayout>
