---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="시스템 대시보드 — 뇌와 마음사이" activePage="dashboard">
  <style>
    /* Dashboard-specific styles */
    .dash-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:16px;padding:1.5rem;transition:all .3s ease}
    .dash-card:hover{background:var(--card-hover-bg);transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,.08)}
    [data-theme="science"] .dash-card:hover{box-shadow:0 8px 32px rgba(0,0,0,.3)}

    /* System cycle */
    .cycle-node{position:relative;display:flex;flex-direction:column;align-items:center;gap:.6rem;padding:1.2rem 1rem;border-radius:16px;background:var(--bg-card);border:2px solid var(--card-border);transition:all .3s ease;cursor:default;min-width:130px}
    .cycle-node:hover{transform:translateY(-4px)}
    .cycle-node-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem}
    .cycle-arrow{color:var(--text-muted);font-size:1.5rem;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    @media(max-width:768px){
      .cycle-desktop{display:none!important}
      .cycle-mobile{display:flex!important}
    }
    @media(min-width:769px){
      .cycle-desktop{display:flex!important}
      .cycle-mobile{display:none!important}
    }

    /* Stat counter */
    .stat-box{background:var(--bg-card);border:1px solid var(--card-border);border-radius:14px;padding:1.2rem;text-align:center;transition:all .3s ease}
    .stat-box:hover{border-color:var(--accent-glow);transform:translateY(-2px)}
    .stat-number{font-size:2.2rem;font-weight:800;line-height:1;color:var(--accent);letter-spacing:-.03em}
    .stat-label{font-size:.82rem;color:var(--text-dim);margin-top:.35rem;font-weight:500}

    /* Topic pipeline */
    .topic-card{background:var(--bg-card);border:1px solid var(--card-border);border-radius:12px;padding:1rem 1.15rem;transition:all .25s ease;display:flex;flex-direction:column;gap:.5rem}
    .topic-card:hover{background:var(--card-hover-bg);border-color:rgba(79,195,247,.2)}
    .topic-num{font-size:.7rem;font-weight:800;letter-spacing:.1em;color:var(--text-muted);font-variant-numeric:tabular-nums}
    .topic-title{font-size:.9rem;font-weight:600;line-height:1.35;color:var(--text)}
    .status-badge{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .6rem;border-radius:100px;font-size:.68rem;font-weight:700;letter-spacing:.02em}
    .status-research{background:rgba(79,195,247,.1);border:1px solid rgba(79,195,247,.2);color:#4FC3F7}
    .status-axon{background:rgba(255,213,79,.1);border:1px solid rgba(255,213,79,.25);color:#FFD54F}
    .status-draft{background:rgba(255,112,67,.1);border:1px solid rgba(255,112,67,.2);color:#FF7043}
    .status-waiting{background:rgba(107,107,128,.08);border:1px solid rgba(107,107,128,.15);color:var(--text-muted)}
    .pl-badge{font-size:.65rem;font-weight:700;padding:.15rem .5rem;border-radius:100px;background:rgba(107,107,128,.06);border:1px solid rgba(107,107,128,.12);color:var(--text-muted);letter-spacing:.04em}
    [data-theme="science"] .pl-badge{background:rgba(200,196,216,.06);border-color:rgba(200,196,216,.12)}

    /* System profile cards */
    .sys-profile{background:var(--bg-card);border:1px solid var(--card-border);border-radius:16px;padding:1.5rem;transition:all .3s ease;display:flex;flex-direction:column;gap:1rem}
    .sys-profile:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.08)}
    [data-theme="science"] .sys-profile:hover{box-shadow:0 12px 40px rgba(0,0,0,.35)}
    .sys-icon-box{width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
    .strength-item,.gap-item{display:flex;align-items:flex-start;gap:.45rem;font-size:.82rem;line-height:1.5}
    .strength-item{color:var(--text-dim)}
    .gap-item{color:var(--text-dim)}

    /* Roadmap */
    .roadmap-item{display:flex;align-items:center;gap:.85rem;padding:.85rem 1rem;border-radius:12px;background:var(--bg-card);border:1px solid var(--card-border);transition:all .2s}
    .roadmap-item:hover{background:var(--card-hover-bg)}
    .roadmap-check{width:22px;height:22px;border-radius:7px;border:2px solid var(--divider);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem}
    .roadmap-check.done{background:rgba(102,187,106,.15);border-color:rgba(102,187,106,.5);color:#66BB6A}
    .roadmap-check.progress{background:rgba(255,213,79,.12);border-color:rgba(255,213,79,.4);color:#FFD54F}
    .roadmap-check.todo{background:rgba(107,107,128,.05);border-color:var(--divider);color:transparent}

    /* Ontology layers */
    .onto-layer{display:flex;align-items:flex-start;gap:1rem;padding:1.1rem 1.2rem;border-radius:14px;background:var(--bg-card);border:1px solid var(--card-border);transition:all .25s ease}
    .onto-layer:hover{background:var(--card-hover-bg)}
    .onto-num{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:800;flex-shrink:0}

    /* Section headings */
    .section-title{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;letter-spacing:-.03em;line-height:1.15;margin-bottom:.4rem}
    .section-sub{font-size:1rem;color:var(--text-dim);margin-bottom:2rem;line-height:1.6}

    /* Workflow diagram */
    .workflow-box{background:var(--bg-card);border:1px solid var(--card-border);border-radius:14px;padding:1.2rem 1.5rem;transition:all .25s ease}
    .workflow-box:hover{background:var(--card-hover-bg)}
    .workflow-arrow{display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:1.4rem;flex-shrink:0}
    @media(max-width:768px){
      .workflow-row{flex-direction:column!important}
      .workflow-arrow iconify-icon{transform:rotate(90deg)}
    }

    /* Pipeline steps */
    .pipe-step{display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .65rem;border-radius:8px;font-size:.72rem;font-weight:600;background:rgba(255,213,79,.08);border:1px solid rgba(255,213,79,.18);color:var(--text-dim)}

    /* RN pipeline list */
    .rn-item{display:flex;align-items:center;gap:.6rem;padding:.5rem .75rem;border-radius:10px;font-size:.82rem;color:var(--text-dim);background:var(--bg-card);border:1px solid var(--card-border);transition:all .2s}
    .rn-item:hover{background:var(--card-hover-bg)}

    /* Stats grid responsive */
    @media(max-width:640px){
      #stats-grid{grid-template-columns:repeat(3,1fr)!important;}
    }
    @media(max-width:380px){
      #stats-grid{grid-template-columns:repeat(2,1fr)!important;}
    }
  </style>

<!-- 1. SUB-PAGE HERO -->
<section style="padding:8rem 0 4rem;background:var(--bg-deep);">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal">
      <span class="badge badge-neu" style="margin-bottom:1.2rem;display:inline-flex;">ONTOLOGY-BASED SYSTEM</span>
    </div>
    <h1 class="reveal d1" style="font-size:clamp(2.5rem,5vw,4rem);font-weight:800;letter-spacing:-.04em;line-height:1.1;margin-bottom:.75rem;">
      시스템 대시보드
    </h1>
    <p class="reveal d2" style="font-size:1.15rem;color:var(--text-dim);line-height:1.6;max-width:540px;">
      뇌와마음사이 콘텐츠 생산 파이프라인의 현재 상태
    </p>
  </div>
</section>


<!-- 2. SYSTEM CYCLE DIAGRAM -->
<section style="padding:3rem 0 4rem;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal">
      <p class="section-title">시스템 사이클</p>
      <p class="section-sub">6개 서브시스템이 순환하며 콘텐츠를 생산합니다</p>
    </div>

    <!-- Desktop: Hub-and-Spoke Architecture -->
    <div class="cycle-desktop reveal d1" style="display:none;flex-direction:column;align-items:center;gap:2rem;">
      <!-- Main Pipeline Row -->
      <div style="display:flex;align-items:center;gap:1rem;justify-content:center;width:100%;">
        <div class="cycle-node" style="border-color:rgba(255,112,67,.35);">
          <div class="cycle-node-icon" style="background:rgba(255,112,67,.12);color:#FF7043;">
            <iconify-icon icon="solar:pen-2-bold"></iconify-icon>
          </div>
          <span style="font-size:.95rem;font-weight:800;color:#FF7043;">MUSE</span>
          <span style="font-size:.72rem;color:var(--text-dim);">연구 · 글쓰기</span>
        </div>
        <div class="cycle-arrow"><iconify-icon icon="solar:arrow-right-bold" style="font-size:1.5rem;color:var(--text-muted);"></iconify-icon></div>
        <div class="cycle-node" style="border-color:rgba(79,195,247,.35);">
          <div class="cycle-node-icon" style="background:rgba(79,195,247,.12);color:#4FC3F7;">
            <iconify-icon icon="solar:global-bold"></iconify-icon>
          </div>
          <span style="font-size:.95rem;font-weight:800;color:#4FC3F7;">NOVA</span>
          <span style="font-size:.72rem;color:var(--text-dim);">디자인 · 발행</span>
        </div>
        <div class="cycle-arrow"><iconify-icon icon="solar:arrow-right-bold" style="font-size:1.5rem;color:var(--text-muted);"></iconify-icon></div>
        <div class="cycle-node" style="border-color:rgba(255,213,79,.35);">
          <div class="cycle-node-icon" style="background:rgba(255,213,79,.12);color:#FFD54F;">
            <iconify-icon icon="solar:videocamera-bold"></iconify-icon>
          </div>
          <span style="font-size:.95rem;font-weight:800;color:#FFD54F;">AXON</span>
          <span style="font-size:.72rem;color:var(--text-dim);">영상 제작</span>
        </div>
      </div>

      <!-- LEO Support Layer -->
      <div style="position:relative;display:flex;align-items:center;justify-content:center;width:100%;max-width:560px;">
        <div style="position:absolute;top:50%;left:20%;right:20%;height:1px;border-top:2px dashed rgba(255,167,38,.25);"></div>
        <div style="display:flex;align-items:center;gap:2.5rem;position:relative;z-index:1;">
          <div style="display:flex;flex-direction:column;align-items:center;gap:.2rem;">
            <iconify-icon icon="solar:arrow-up-bold" style="font-size:1rem;color:rgba(255,167,38,.5);"></iconify-icon>
            <span style="font-size:.6rem;color:var(--text-muted);">요청 시</span>
          </div>
          <div class="cycle-node" style="border-color:rgba(255,167,38,.4);background:rgba(255,167,38,.03);min-width:150px;">
            <div class="cycle-node-icon" style="background:rgba(255,167,38,.15);color:#FFA726;">
              <iconify-icon icon="solar:gallery-bold"></iconify-icon>
            </div>
            <span style="font-size:.95rem;font-weight:800;color:#FFA726;">LEO</span>
            <span style="font-size:.72rem;color:var(--text-dim);">이미지 · 인포그래픽</span>
            <span style="font-size:.6rem;color:var(--text-muted);font-style:italic;">on-demand 지원</span>
          </div>
          <div style="display:flex;flex-direction:column;align-items:center;gap:.2rem;">
            <iconify-icon icon="solar:arrow-up-bold" style="font-size:1rem;color:rgba(255,167,38,.5);"></iconify-icon>
            <span style="font-size:.6rem;color:var(--text-muted);">요청 시</span>
          </div>
        </div>
      </div>

      <!-- Feedback Row -->
      <div style="display:flex;align-items:center;gap:1rem;justify-content:center;width:100%;">
        <div style="display:flex;align-items:center;gap:.5rem;padding:.6rem 1rem;border-radius:12px;border:1px dashed rgba(171,71,188,.3);">
          <iconify-icon icon="solar:chart-bold" style="color:#AB47BC;font-size:1.1rem;"></iconify-icon>
          <span style="font-size:.82rem;font-weight:700;color:#AB47BC;">PULSE</span>
          <span style="font-size:.72rem;color:var(--text-dim);">분석</span>
        </div>
        <iconify-icon icon="solar:arrow-left-bold" style="font-size:1.2rem;color:var(--text-muted);"></iconify-icon>
        <div style="display:flex;align-items:center;gap:.5rem;padding:.6rem 1rem;border-radius:12px;border:1px dashed rgba(102,187,106,.3);">
          <iconify-icon icon="solar:shield-check-bold" style="color:#66BB6A;font-size:1.1rem;"></iconify-icon>
          <span style="font-size:.82rem;font-weight:700;color:#66BB6A;">QUALITAS</span>
          <span style="font-size:.72rem;color:var(--text-dim);">평가</span>
        </div>
        <span style="font-size:.7rem;color:var(--text-muted);margin-left:.5rem;">→ MUSE로 피드백</span>
      </div>
    </div>

    <!-- Mobile cycle -->
    <div class="cycle-mobile reveal d1" style="display:none;flex-direction:column;align-items:center;gap:.6rem;">
      <p style="font-size:.7rem;font-weight:700;color:var(--text-muted);letter-spacing:.1em;margin-bottom:.3rem;">메인 파이프라인</p>
      <div class="cycle-node" style="border-color:rgba(255,112,67,.35);width:100%;max-width:280px;flex-direction:row;gap:1rem;padding:1rem 1.2rem;">
        <div class="cycle-node-icon" style="background:rgba(255,112,67,.12);color:#FF7043;width:42px;height:42px;min-width:42px;font-size:1.2rem;"><iconify-icon icon="solar:pen-2-bold"></iconify-icon></div>
        <div><span style="font-size:.85rem;font-weight:800;color:#FF7043;">MUSE</span><span style="font-size:.72rem;color:var(--text-dim);margin-left:.4rem;">연구 · 글쓰기</span></div>
      </div>
      <iconify-icon icon="solar:arrow-down-bold" style="font-size:1rem;color:var(--text-muted);"></iconify-icon>
      <div class="cycle-node" style="border-color:rgba(79,195,247,.35);width:100%;max-width:280px;flex-direction:row;gap:1rem;padding:1rem 1.2rem;">
        <div class="cycle-node-icon" style="background:rgba(79,195,247,.12);color:#4FC3F7;width:42px;height:42px;min-width:42px;font-size:1.2rem;"><iconify-icon icon="solar:global-bold"></iconify-icon></div>
        <div><span style="font-size:.85rem;font-weight:800;color:#4FC3F7;">NOVA</span><span style="font-size:.72rem;color:var(--text-dim);margin-left:.4rem;">디자인 · 발행</span></div>
      </div>
      <iconify-icon icon="solar:arrow-down-bold" style="font-size:1rem;color:var(--text-muted);"></iconify-icon>
      <div class="cycle-node" style="border-color:rgba(255,213,79,.35);width:100%;max-width:280px;flex-direction:row;gap:1rem;padding:1rem 1.2rem;">
        <div class="cycle-node-icon" style="background:rgba(255,213,79,.12);color:#FFD54F;width:42px;height:42px;min-width:42px;font-size:1.2rem;"><iconify-icon icon="solar:videocamera-bold"></iconify-icon></div>
        <div><span style="font-size:.85rem;font-weight:800;color:#FFD54F;">AXON</span><span style="font-size:.72rem;color:var(--text-dim);margin-left:.4rem;">영상 제작</span></div>
      </div>
      <div style="margin:1rem 0 .3rem;"><p style="font-size:.7rem;font-weight:700;color:var(--text-muted);letter-spacing:.1em;">ON-DEMAND 지원</p></div>
      <div class="cycle-node" style="border-color:rgba(255,167,38,.4);width:100%;max-width:280px;flex-direction:row;gap:1rem;padding:1rem 1.2rem;background:rgba(255,167,38,.02);">
        <div class="cycle-node-icon" style="background:rgba(255,167,38,.15);color:#FFA726;width:42px;height:42px;min-width:42px;font-size:1.2rem;"><iconify-icon icon="solar:gallery-bold"></iconify-icon></div>
        <div><span style="font-size:.85rem;font-weight:800;color:#FFA726;">LEO</span><span style="font-size:.72rem;color:var(--text-dim);margin-left:.3rem;">→ NOVA · AXON에 이미지 지원</span></div>
      </div>
      <div style="margin:.8rem 0 .3rem;"><p style="font-size:.7rem;font-weight:700;color:var(--text-muted);letter-spacing:.1em;">피드백 루프</p></div>
      <div style="display:flex;gap:.5rem;width:100%;max-width:280px;">
        <div style="flex:1;display:flex;align-items:center;gap:.4rem;padding:.7rem;border-radius:12px;border:1px dashed rgba(102,187,106,.3);">
          <iconify-icon icon="solar:shield-check-bold" style="color:#66BB6A;font-size:1rem;"></iconify-icon>
          <span style="font-size:.78rem;font-weight:700;color:#66BB6A;">QUALITAS</span>
        </div>
        <div style="flex:1;display:flex;align-items:center;gap:.4rem;padding:.7rem;border-radius:12px;border:1px dashed rgba(171,71,188,.3);">
          <iconify-icon icon="solar:chart-bold" style="color:#AB47BC;font-size:1rem;"></iconify-icon>
          <span style="font-size:.78rem;font-weight:700;color:#AB47BC;">PULSE</span>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- 3. STATS COUNTERS -->
<section style="padding:2rem 0 4rem;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal" style="display:grid;grid-template-columns:repeat(6,1fr);gap:1rem;" id="stats-grid">
      <div class="stat-box d1">
        <div class="stat-number" data-target="8">0</div>
        <div class="stat-label">아이디어</div>
        <div style="font-size:.68rem;color:var(--text-muted);margin-top:.25rem;">3개 카테고리</div>
      </div>
      <div class="stat-box d2">
        <div class="stat-number" data-target="72">0</div>
        <div class="stat-label">연구자료 (RS)</div>
        <div style="font-size:.68rem;color:var(--text-muted);margin-top:.25rem;">활성 4 · 축적 68</div>
      </div>
      <div class="stat-box d3">
        <div class="stat-number" data-target="1">0</div>
        <div class="stat-label">리서치노트 (RN)</div>
      </div>
      <div class="stat-box d4">
        <div class="stat-number" data-target="11">0</div>
        <div class="stat-label">플레이리스트</div>
      </div>
      <div class="stat-box d5">
        <div class="stat-number" data-target="4">0</div>
        <div class="stat-label">시스템 문서</div>
      </div>
      <div class="stat-box" style="transition-delay:.6s;">
        <div class="stat-number" data-target="14">0</div>
        <div class="stat-label">개선과제</div>
      </div>
    </div>
  </div>
</section>


<!-- 4. TOPIC CREATION WORKFLOW -->
<section style="padding:3rem 0 4rem;">
  <div class="max-w-5xl mx-auto px-6">
    <div class="reveal">
      <p class="section-title">토픽 생성 워크플로</p>
      <p class="section-sub">MUSE 연구가 완료되면, NOVA 핸드오프 시점에 토픽 폴더가 탄생합니다</p>
    </div>

    <div class="reveal d1 workflow-row" style="display:flex;align-items:stretch;gap:1rem;">
      <div class="workflow-box" style="flex:1;border-left:3px solid #4FC3F7;">
        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;">
          <iconify-icon icon="solar:test-tube-bold" style="font-size:1.1rem;color:#4FC3F7;"></iconify-icon>
          <span style="font-size:.85rem;font-weight:800;color:#4FC3F7;letter-spacing:-.01em;">MUSE</span>
          <span class="pl-badge" style="margin-left:auto;">cortex/ 폴더</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:.4rem;">
          <div style="display:flex;align-items:center;gap:.4rem;font-size:.82rem;color:var(--text-dim);">
            <iconify-icon icon="solar:lightbulb-bold" style="font-size:.9rem;color:#FFD54F;"></iconify-icon>
            <span>아이디어</span>
          </div>
          <div style="display:flex;align-items:center;gap:.4rem;font-size:.82rem;color:var(--text-dim);">
            <iconify-icon icon="solar:arrow-right-linear" style="font-size:.8rem;"></iconify-icon>
            <span>RS (연구자료)</span>
          </div>
          <div style="display:flex;align-items:center;gap:.4rem;font-size:.82rem;color:var(--text-dim);">
            <iconify-icon icon="solar:arrow-right-linear" style="font-size:.8rem;"></iconify-icon>
            <span>RN (리서치노트)</span>
          </div>
        </div>
        <p style="font-size:.72rem;color:var(--text-muted);margin-top:.6rem;font-style:italic;">토픽 폴더 없음</p>
      </div>

      <div class="workflow-arrow">
        <iconify-icon icon="solar:arrow-right-bold" style="font-size:1.6rem;"></iconify-icon>
      </div>

      <div class="workflow-box" style="flex:1;border-left:3px solid #FF7043;">
        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;">
          <iconify-icon icon="solar:pen-bold" style="font-size:1.1rem;color:#FF7043;"></iconify-icon>
          <span style="font-size:.85rem;font-weight:800;color:#FF7043;letter-spacing:-.01em;">NOVA 핸드오프</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:.4rem;">
          <div style="display:flex;align-items:center;gap:.4rem;font-size:.82rem;color:var(--text-dim);">
            <iconify-icon icon="solar:folder-bold" style="font-size:.9rem;color:#FF7043;"></iconify-icon>
