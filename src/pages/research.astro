---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="연구 노트 — 뇌와 마음사이" activePage="research">
  <style>
    /* Research image card grid */
    .research-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem}
    @media(max-width:768px){.research-grid{grid-template-columns:1fr}}

    .research-card{display:block;border-radius:1rem;overflow:hidden;background:var(--bg-card);border:1px solid var(--card-border);text-decoration:none;color:inherit;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s ease,border-color .3s ease;cursor:pointer}
    .research-card:hover{transform:translateY(-4px);box-shadow:0 16px 48px rgba(0,0,0,.12);border-color:rgba(79,195,247,.25)}
    .research-card-img{aspect-ratio:16/9;overflow:hidden;position:relative}
    .research-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
    .research-card:hover .research-card-img img{transform:scale(1.03)}
    .research-card-body{padding:1.25rem 1.5rem}
    .research-card-meta{display:flex;align-items:center;gap:.6rem;margin-bottom:.6rem;flex-wrap:wrap}
    .research-card h3{font-size:1.15rem;font-weight:700;line-height:1.35;word-break:keep-all;margin-bottom:.4rem;color:var(--text)}
    .research-card p{font-size:.88rem;color:var(--text-dim);line-height:1.6;word-break:keep-all}
    .reading-time{font-size:.75rem;color:var(--text-muted);font-weight:500}

    /* Featured card */
    .research-card.featured{grid-column:span 2}
    .research-card.featured .research-card-img{aspect-ratio:2.2/1}
    .research-card.featured h3{font-size:1.35rem}
    @media(max-width:768px){.research-card.featured{grid-column:span 1}.research-card.featured .research-card-img{aspect-ratio:16/9}}

    /* Filter pills */
    .filter-pill{padding:.4rem .95rem;border-radius:100px;border:1px solid var(--divider);font-size:.82rem;font-weight:500;cursor:pointer;transition:all .2s;background:var(--bg-card);color:var(--text-dim);white-space:nowrap}
    .filter-pill:hover{border-color:rgba(79,195,247,.3);color:var(--text)}
    .filter-pill.active{background:var(--badge-brain-bg);border-color:var(--accent-glow);color:var(--accent);font-weight:700}
    /* Search */
    .search-bar{width:100%;padding:.8rem 1.2rem .8rem 3rem;border-radius:100px;background:var(--bg-card);border:1px solid var(--divider);color:var(--text);font-family:'Pretendard',sans-serif;font-size:.95rem;outline:none;transition:all .2s}
    .search-bar:focus{border-color:rgba(79,195,247,.35);background:var(--card-hover-bg)}
    .search-bar::placeholder{color:var(--text-dim)}
  </style>

<!-- 1. MINI HERO -->
<section style="padding:7rem 0 3rem;background:var(--bg-deep);">
  <div class="max-w-4xl mx-auto px-6">
    <div class="reveal">
      <span class="badge badge-neu" style="margin-bottom:1.2rem;display:inline-flex;">CORTEX ARCHIVE</span>
    </div>
    <h1 class="reveal d1" style="font-size:clamp(2.5rem,5vw,4rem);font-weight:800;letter-spacing:-.04em;line-height:1.1;margin-bottom:.75rem;word-break:keep-all;">
      코르의 연구 노트
    </h1>
    <p class="reveal d2" style="font-size:1.1rem;color:var(--text-dim);margin-bottom:1.5rem;">
      피어리뷰 논문 기반. 추측 없이.
    </p>
    <div class="reveal d2" style="display:flex;align-items:center;gap:.65rem;margin-bottom:1.6rem;flex-wrap:wrap;">
      <span style="font-size:2.4rem;font-weight:800;color:var(--accent);line-height:1;">22</span>
      <span style="font-size:1.05rem;color:var(--text-dim);font-weight:500;">개 연구 노트</span>
      <span style="width:1px;height:1.2rem;background:var(--divider);"></span>
      <span style="font-size:.9rem;color:var(--text-dim);">3개 이상 논문 인용</span>
    </div>
    <div class="reveal d3" style="border-left:2px solid var(--accent);padding-left:1rem;">
      <p style="font-size:.92rem;font-style:italic;color:var(--text-dim);">"자, 데이터 보겠습니다."</p>
    </div>
  </div>
</section>

<!-- 2. STICKY SEARCH + FILTER ZONE -->
<div style="position:sticky;top:0;background:var(--glass-bg);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--divider);padding:1.2rem 0;z-index:30;">
  <div class="max-w-4xl mx-auto px-6">
    <!-- Search bar -->
    <div style="position:relative;">
      <iconify-icon icon="solar:magnifer-linear" style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1.1rem;color:var(--text-dim);pointer-events:none;"></iconify-icon>
      <input type="text" class="search-bar" placeholder="연구 노트 검색...">
    </div>
    <!-- Filter row -->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;margin-top:.85rem;flex-wrap:wrap;">
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;flex:1;">
        <button class="filter-pill active" data-filter="전체">전체</button>
        <button class="filter-pill" data-filter="뇌의 착각">🧠 뇌의 착각</button>
        <button class="filter-pill" data-filter="뇌의 수면">😴 뇌의 수면</button>
        <button class="filter-pill" data-filter="뇌의 회로">🔥 뇌의 회로</button>
        <button class="filter-pill" data-filter="뇌의 훈련">📚 뇌의 훈련</button>
        <button class="filter-pill" data-filter="뇌 vs AI">🤖 뇌 vs AI</button>
        <button class="filter-pill" data-filter="마음의 온도">💛 마음의 온도</button>
        <button class="filter-pill" data-filter="마음의 회복">💊 마음의 회복</button>
        <button class="filter-pill" data-filter="마음의 그늘">🌑 마음의 그늘</button>
        <button class="filter-pill" data-filter="문화 속 마음">🌍 문화 속 마음</button>
        <button class="filter-pill" data-filter="위대한 실험들">🔬 위대한 실험들</button>
      </div>
      <div style="display:flex;align-items:center;gap:.3rem;flex-shrink:0;">
        <button id="sort-recent" style="padding:.3rem .75rem;border-radius:100px;font-size:.8rem;font-weight:600;cursor:pointer;border:1px solid var(--accent-glow);background:var(--badge-brain-bg);color:var(--accent);transition:all .2s;">최신순</button>
        <span style="font-size:.8rem;color:var(--text-muted);">|</span>
        <button id="sort-playlist" style="padding:.3rem .75rem;border-radius:100px;font-size:.8rem;font-weight:500;cursor:pointer;border:1px solid var(--divider);background:transparent;color:var(--text-dim);transition:all .2s;">플레이리스트순</button>
      </div>
    </div>
  </div>
</div>

<!-- 3. RESEARCH GRID -->
<section style="padding:2.5rem 0 5rem;">
  <div class="max-w-4xl mx-auto px-6">
    <div class="research-grid" id="card-list">

      <!-- Card 02 — FEATURED (최신) -->
      <a href={`${base}articles/article-02/`} class="research-card featured reveal d1" data-category="뇌가 속는 방법">
        <div class="research-card-img" style="background:linear-gradient(135deg, rgba(255,112,67,.15), rgba(26,26,62,.4));display:flex;align-items:center;justify-content:center;">
          <span style="font-size:3rem;">🧠</span>
        </div>
        <div class="research-card-body">
          <div class="research-card-meta">
            <span class="badge badge-mind">🧠 뇌가 속는 방법</span>
            <span class="reading-time">14분</span>
          </div>
          <h3>유료 강좌가 당신 뇌를 속이는 5가지 방법</h3>
          <p>속은 게 아닙니다. 뇌가 설계된 대로 반응한 겁니다.</p>
        </div>
      </a>

      <!-- Card 01 -->
      <a href={`${base}articles/article-01/`} class="research-card reveal d2" data-category="뇌의 착각">
        <div class="research-card-img">
          <img src={`${base}images/art01/banner.png`} alt="뇌세포가 게임을 배운 실험" loading="lazy">
        </div>
        <div class="research-card-body">
          <div class="research-card-meta">
            <span class="badge badge-brain">🤖 뇌, AI랑 다를까요?</span>
            <span class="reading-time">12분</span>
          </div>
          <h3>사람의 뇌는 AI보다 뛰어난 걸까?</h3>
          <p>접시 위 뉴런 20만 개가 둠을 플레이한 날, 떠오른 질문</p>
        </div>
      </a>

    </div>
  </div>
</section>

  <script is:inline>
    // Category filter
    const filterBtns=document.querySelectorAll('.filter-pill');
    const cards=document.querySelectorAll('.research-card');
    filterBtns.forEach(btn=>{
      btn.addEventListener('click',()=>{
        filterBtns.forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const cat=btn.dataset.filter;
        cards.forEach(card=>{
          card.style.display=(cat==='전체'||card.dataset.category===cat)?'':'none';
        });
      });
    });

    // Search
    const searchInput=document.querySelector('.search-bar');
    searchInput?.addEventListener('input',e=>{
      const q=e.target.value.toLowerCase();
      if(!q){cards.forEach(c=>c.style.display='');return;}
      cards.forEach(card=>{
        const title=card.querySelector('h3').textContent.toLowerCase();
        const teaser=card.querySelector('p')?.textContent.toLowerCase()||'';
        card.style.display=(title.includes(q)||teaser.includes(q))?'':'none';
      });
    });

    // Sort toggle
    const sortRecent=document.getElementById('sort-recent');
    const sortPlaylist=document.getElementById('sort-playlist');
    sortRecent?.addEventListener('click',()=>{
      sortRecent.style.background='var(--badge-brain-bg)';
      sortRecent.style.borderColor='var(--accent-glow)';
      sortRecent.style.color='var(--accent)';
      sortRecent.style.fontWeight='700';
      sortPlaylist.style.background='transparent';
      sortPlaylist.style.borderColor='var(--divider)';
      sortPlaylist.style.color='var(--text-dim)';
      sortPlaylist.style.fontWeight='500';
    });
    sortPlaylist?.addEventListener('click',()=>{
      sortPlaylist.style.background='var(--badge-brain-bg)';
      sortPlaylist.style.borderColor='var(--accent-glow)';
      sortPlaylist.style.color='var(--accent)';
      sortPlaylist.style.fontWeight='700';
      sortRecent.style.background='transparent';
      sortRecent.style.borderColor='var(--divider)';
      sortRecent.style.color='var(--text-dim)';
      sortRecent.style.fontWeight='500';
    });
  </script>
</BaseLayout>
