---
import BaseLayout from '../layouts/BaseLayout.astro';
import projectStatus from '../data/project-status.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const m = projectStatus.metrics;
---

<BaseLayout title="뇌와 마음 사이 — 인지신경과학 채널" activePage="home">
  <Fragment slot="head">
    <style>
      .home-hero{position:relative;min-height:88dvh;overflow:hidden;padding:8.4rem 0 4.5rem;background:radial-gradient(circle at 78% 18%,rgba(233,181,156,.26),transparent 30%),linear-gradient(180deg,var(--bg-mid),var(--bg-deep));border-bottom:1px solid var(--divider)}
      [data-theme="science"] .home-hero{background:radial-gradient(circle at 78% 22%,rgba(122,166,255,.2),transparent 34%),linear-gradient(180deg,#07090f 0%,#0d1220 62%,#07090f 100%)}
      .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);gap:2.5rem;align-items:center}
      .hero-copy{position:relative;z-index:2;max-width:620px;isolation:isolate}
      .hero-copy::before{content:"";position:absolute;inset:-1.1rem -2rem -1.25rem -1.2rem;background:linear-gradient(90deg,color-mix(in srgb,var(--bg-deep) 88%,transparent),color-mix(in srgb,var(--bg-deep) 52%,transparent),transparent);z-index:-1;pointer-events:none}
      .hero-kicker{font-size:.78rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:1.35rem}
      .hero-title{font-size:clamp(3.35rem,8vw,6.9rem);font-weight:800;line-height:.98;letter-spacing:0;word-break:keep-all;color:var(--text);text-shadow:0 2px 22px color-mix(in srgb,var(--bg-deep) 82%,transparent);margin-bottom:1.5rem}
      [data-theme="science"] .hero-title{text-shadow:0 0 34px rgba(122,166,255,.18)}
      .hero-title .mind-word{color:var(--accent)}
      [data-theme="science"] .hero-title .mind-word{color:var(--text)}
      [data-theme="science"] .hero-title .brain-word{color:var(--accent)}
      .hero-lead{font-size:1.12rem;line-height:1.78;color:var(--text-dim);word-break:keep-all;max-width:520px;margin-bottom:2rem}
      .hero-lead strong{color:var(--text);font-weight:700}
      .hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;align-items:center}
      .hero-secondary{display:inline-flex;align-items:center;gap:.5rem;padding:.82rem 1.25rem;border:1px solid var(--divider);border-radius:999px;background:var(--glass-bg);color:var(--text);font-weight:700;text-decoration:none;box-shadow:var(--glass-shadow);transition:color .24s ease,background .24s ease,border-color .24s ease,box-shadow .24s ease,transform .24s ease}
      .hero-secondary:hover{border-color:var(--accent);transform:translateY(-2px)}
      .hero-proof{margin-top:2.75rem;display:flex;gap:.6rem;flex-wrap:wrap;color:var(--text-muted)}
      .hero-proof span{padding:.42rem .7rem;border-radius:999px;border:1px solid var(--divider);background:color-mix(in srgb,var(--bg-card) 72%,transparent);font-size:.78rem;font-weight:800}
      .constellation-wrap{position:relative;min-height:520px}
      .constellation-card{position:relative;min-height:520px;border:1px solid var(--divider);border-radius:18px;background:color-mix(in srgb,var(--bg-card) 48%,transparent);box-shadow:var(--glass-shadow);overflow:hidden}
      .constellation-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 60% 30%,var(--accent-glow),transparent 32%);opacity:.55}
      .constellation-caption{position:absolute;left:1.25rem;bottom:1.1rem;z-index:2;color:var(--text-muted);font-size:.78rem;line-height:1.7}
      .constellation-caption strong{display:block;color:var(--text);font-size:1rem;margin-bottom:.2rem}
      .constellation-map{position:absolute;inset:0;width:100%;height:100%;z-index:1}
      .constellation-line{stroke:var(--accent);stroke-width:1;stroke-linecap:round;opacity:.45;stroke-dasharray:1 6;animation:mindThread 16s linear infinite}
      [data-theme="science"] .constellation-line{stroke-dasharray:none;animation:neuronPulse 4.8s ease-in-out infinite}
      .constellation-node-halo{fill:var(--accent);opacity:.11}
      .constellation-node-ring{fill:none;stroke:var(--accent);stroke-width:.8;opacity:.36}
      .constellation-node-core{fill:var(--accent);filter:url(#node-soft);animation:mindNode 5.4s ease-in-out infinite}
      [data-theme="science"] .constellation-node-halo{opacity:.16}
      [data-theme="science"] .constellation-node-ring{display:none}
      [data-theme="science"] .constellation-node-core{filter:url(#node-glow);animation:neuronNode 3.4s ease-in-out infinite}
      .constellation-label{font-size:12px;fill:var(--text);font-weight:700}
      [data-theme="science"] .constellation-label{fill:var(--text-dim);font-weight:500}
      .hero-mode-copy-day{display:block}
      .hero-mode-copy-night{display:none}
      [data-theme="science"] .hero-mode-copy-day{display:none}
      [data-theme="science"] .hero-mode-copy-night{display:block}
      @keyframes mindThread{to{stroke-dashoffset:-42}}
      @keyframes mindNode{0%,100%{opacity:.78;transform:scale(1)}50%{opacity:1;transform:scale(1.08)}}
      @keyframes neuronPulse{0%,100%{opacity:.16}50%{opacity:.62}}
      @keyframes neuronNode{0%,100%{opacity:.58}50%{opacity:1}}
      @media(max-width:640px){
        .home-hero{min-height:86dvh;padding:7rem 0 3.2rem}
        .hero-grid{grid-template-columns:1fr;gap:1.4rem}
        .hero-copy::before{inset:-.75rem -1rem -1rem}
        .hero-lead{font-size:1.02rem}
        .constellation-wrap{min-height:360px}
        .constellation-card{min-height:360px}
        .constellation-label{font-size:13px}
      }
      @media(min-width:641px) and (max-width:980px){.hero-grid{grid-template-columns:1fr}.constellation-wrap{min-height:480px}}
    </style>
  </Fragment>

  <!-- HERO -->
  <section class="home-hero">
    <div class="w-full max-w-7xl mx-auto px-6 lg:px-8">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker hero-auto-down">
            <span class="hero-mode-copy-day">오늘, 마음이 머문 자리</span>
            <span class="hero-mode-copy-night">지금 펼쳐진 노트들</span>
          </p>
          <h1 class="hero-title hero-auto-up-1"><span class="brain-word">뇌</span>와 <span class="mind-word">마음</span><br>사이</h1>
          <p class="hero-lead hero-auto-up-2">
            <span class="hero-mode-copy-day">마음의 결을 따라 걸어보세요. 한 점은 하나의 질문이고, 선은 같은 감정과 회복으로 이어진 글입니다.</span>
            <span class="hero-mode-copy-night">밤의 뇌 속을 산책하세요. 별처럼 빛나는 노드 하나가 한 편의 에세이로 이어집니다.</span>
            <br><strong>뇌과학의 정확함과 심리학의 온기</strong>를 코르의 언어로 묶습니다.
          </p>
          <div class="hero-actions hero-auto-up-3">
            <a href={`${base}research/`} class="btn-sub" style="padding:.85rem 1.45rem;font-size:1rem;"><iconify-icon icon="solar:book-2-bold" style="font-size:1.05rem;"></iconify-icon>이번 주의 글 읽기</a>
            <a href={`${base}blog/`} class="hero-secondary">개인 노트 보기 <iconify-icon icon="solar:arrow-right-linear" style="font-size:1rem;"></iconify-icon></a>
            <a href={`${base}about/`} class="hero-secondary">코르의 연구소 <iconify-icon icon="solar:arrow-right-linear" style="font-size:1rem;"></iconify-icon></a>
          </div>
          <div class="hero-proof hero-auto-up-4">
            <span>RS {m.researchSources}개 추적</span>
            <span>아티클 {m.siteArticles}개 공개</span>
            <span>블로그 {m.blogPosts}개</span>
          </div>
        </div>
        <div class="constellation-wrap hero-auto-up-5" aria-label="뇌와 마음사이 주제 별자리">
          <div class="constellation-card">
            <svg class="constellation-map" viewBox="0 0 700 520" role="img" aria-labelledby="constellation-title">
              <title id="constellation-title">주제별로 이어진 뇌와 마음사이 콘텐츠 지도</title>
              <defs>
                <filter id="node-soft" x="-60%" y="-60%" width="220%" height="220%">
                  <feGaussianBlur stdDeviation="1.6"/>
                </filter>
                <filter id="node-glow" x="-80%" y="-80%" width="260%" height="260%">
                  <feGaussianBlur stdDeviation="4" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              {[
                [120,90,260,160],[260,160,210,315],[260,160,420,130],[420,130,540,230],
                [540,230,430,370],[430,370,210,315],[430,370,595,430],[210,315,90,390],
              ].map(([x1,y1,x2,y2]) => (
                <line class="constellation-line" x1={x1} y1={y1} x2={x2} y2={y2}></line>
              ))}
              {[
                [120,90,'AI와 뇌'],[260,160,'예측'],[420,130,'회복'],[540,230,'인지편향'],
                [430,370,'정체성'],[210,315,'주의'],[90,390,'기억'],[595,430,'관계'],
              ].map(([cx,cy,label]) => (
                <g class="constellation-node">
                  <circle class="constellation-node-halo" cx={cx} cy={cy} r="22"></circle>
                  <circle class="constellation-node-ring" cx={cx} cy={cy} r="12"></circle>
                  <circle class="constellation-node-core" cx={cx} cy={cy} r="4.8"></circle>
                  <text class="constellation-label" x={Number(cx)+16} y={Number(cy)+4}>{label}</text>
                </g>
              ))}
            </svg>
            <p class="constellation-caption">
              <strong class="hero-mode-copy-day">마음의 연결을 확인하는 지도</strong>
              <strong class="hero-mode-copy-night">뉴런처럼 빛나는 읽기 지도</strong>
              Read · Library · Watch가 하나의 질문으로 이어집니다.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section style="background:var(--bg-mid);border-top:1px solid rgba(79,195,247,.1);border-bottom:1px solid rgba(79,195,247,.08);padding:4rem 0;position:relative;overflow:hidden;">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-center gap-4 mb-9 slide-down delay-1">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full pdot" style="background:var(--accent);"></div>
          <span style="font-size:.8rem;font-weight:700;letter-spacing:.07em;color:var(--accent);text-transform:uppercase;">Brain</span>
          <span style="font-size:.78rem;color:var(--text-muted);">뇌과학 · 데이터 · 메커니즘</span>
        </div>
        <div style="flex:1;height:1px;max-width:70px;background:linear-gradient(90deg,rgba(79,195,247,.5),rgba(255,213,79,.5));"></div>
        <img src="/brainmind-homepage/logo.png" alt="로고" class="w-8 h-8 rounded-xl object-contain float" style="box-shadow:0 0 18px rgba(79,195,247,.45);">
        <div style="flex:1;height:1px;max-width:70px;background:linear-gradient(90deg,rgba(255,213,79,.5),rgba(79,195,247,.5));"></div>
        <div class="flex items-center gap-2">
          <span style="font-size:.78rem;color:var(--text-muted);">감성 · 심리 · 해석</span>
          <span style="font-size:.8rem;font-weight:700;letter-spacing:.07em;color:var(--mind);text-transform:uppercase;">Mind</span>
          <div class="w-2 h-2 rounded-full pdot" style="background:var(--mind);animation-delay:1.1s;"></div>
        </div>
      </div>
      <div class="flex flex-col md:flex-row gap-4">
        <div class="val-item slide-up delay-2">
          <div class="flex items-center gap-3 mb-3"><div style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(79,195,247,.1);border:1px solid rgba(79,195,247,.22);"><iconify-icon icon="solar:document-text-linear" style="font-size:1.15rem;color:var(--accent);"></iconify-icon></div><span style="font-size:.8rem;font-weight:700;letter-spacing:.05em;color:var(--accent);text-transform:uppercase;">Evidence</span></div>
          <p style="font-size:1.05rem;font-weight:700;color:var(--text);margin-bottom:.35rem;">증거</p>
          <p style="font-size:.9rem;color:var(--text-dim);line-height:1.65;word-break:keep-all;">감상이 아닌 논문·실험·데이터만 말한다</p>
        </div>
        <div class="val-item slide-up delay-3">
          <div class="flex items-center gap-3 mb-3"><div style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(255,213,79,.08);border:1px solid rgba(255,213,79,.22);"><iconify-icon icon="solar:target-linear" style="font-size:1.15rem;color:var(--mind);"></iconify-icon></div><span style="font-size:.8rem;font-weight:700;letter-spacing:.05em;color:var(--mind);text-transform:uppercase;">Utility</span></div>
          <p style="font-size:1.05rem;font-weight:700;color:var(--text);margin-bottom:.35rem;">실용</p>
          <p style="font-size:.9rem;color:var(--text-dim);line-height:1.65;word-break:keep-all;">"그래서 내 삶에서 어떻게 쓰나?"까지 간다</p>
        </div>
        <div class="val-item slide-up delay-4">
          <div class="flex items-center gap-3 mb-3"><div style="width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(255,112,67,.08);border:1px solid rgba(255,112,67,.22);"><iconify-icon icon="solar:stars-linear" style="font-size:1.15rem;color:var(--alert);"></iconify-icon></div><span style="font-size:.8rem;font-weight:700;letter-spacing:.05em;color:var(--alert);text-transform:uppercase;">Wonder</span></div>
          <p style="font-size:1.05rem;font-weight:700;color:var(--text);margin-bottom:.35rem;">경이</p>
          <p style="font-size:.9rem;color:var(--text-dim);line-height:1.65;word-break:keep-all;">뇌과학은 공포가 아닌 경이의 대상이다</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section class="cta-gradient" style="padding:5.5rem 0;position:relative;overflow:hidden;">
    <div class="max-w-3xl mx-auto px-6 lg:px-8 text-center" style="position:relative;z-index:1;">
      <div class="glass-card reveal" style="padding:clamp(2.5rem,5vw,4rem) clamp(1.5rem,4vw,3rem);">
        <img src="/brainmind-homepage/logo.png" alt="로고" class="w-14 h-14 rounded-full object-cover mx-auto mb-6 float" style="box-shadow:0 0 26px rgba(79,195,247,.45);">
        <h2 class="reveal d1" style="font-size:clamp(1.9rem,5vw,3rem);font-weight:800;letter-spacing:-.04em;word-break:keep-all;line-height:1.15;margin-bottom:.9rem;">뇌를 알면<br><span class="brain-glow">조금은 덜 휘둘리게</span> 됩니다</h2>
        <p class="reveal d2" style="font-size:.97rem;color:var(--text-dim);line-height:1.75;max-width:440px;margin:0 auto 2rem;word-break:keep-all;">새 영상과 리서치 노트를 가장 먼저 받아보세요.<br>코르가 직접 씁니다.</p>
        <form class="reveal d3" onsubmit="return false;">
          <div style="display:flex;gap:.7rem;max-width:420px;margin:0 auto .9rem;flex-wrap:wrap;justify-content:center;">
            <input type="email" placeholder="이메일 주소" class="glass-input" style="flex:1;min-width:190px;padding:.82rem 1.15rem;font-size:.92rem;">
            <button type="submit" class="btn-sub" style="padding:.82rem 1.5rem;">구독하기</button>
          </div>
          <p style="font-size:.78rem;color:var(--text-muted);">스팸 없음 · 언제든지 구독 해지 가능</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
