---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description = '뇌과학과 심리학을 하나의 언어로. 뇌는 당신을 속인다. 하지만 이해하면 다룰 수 있다.', activePage = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/brainmind-homepage/favicon.svg">
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script is:inline src="https://code.iconify.design/iconify-icon/2.3.0/iconify-icon.min.js"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'brain':'var(--brain)','mind':'var(--mind)','alert':'var(--alert)',
            'bg-deep':'var(--bg-deep)','bg-mid':'var(--bg-mid)','bg-card':'var(--bg-card)',
            'txt':'var(--text)','txt-dim':'var(--text-dim)','txt-muted':'var(--text-muted)',
          },
          fontFamily: { sans: ['Pretendard Variable','Pretendard','Noto Sans KR','Paperlogy','system-ui','sans-serif'] },
        },
      },
    }
  </script>
  <script is:inline>
    // Restore theme before paint
    (function(){const s=localStorage.getItem('theme');if(s==='science')document.documentElement.setAttribute('data-theme','science')})();
  </script>
  <slot name="head" />
</head>
<body>
  <canvas id="bm-atmosphere" aria-hidden="true"></canvas>
  <div class="noise-layer" aria-hidden="true"></div>
  <Nav activePage={activePage} />

  <main>
    <slot />
  </main>

  <Footer />
  <SearchOverlay />

  <script is:inline>
    // Mobile menu
    const ham=document.getElementById('ham');
    const mm=document.getElementById('mobile-menu');
    ham?.addEventListener('click',()=>mm.classList.toggle('hidden'));
    mm?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>mm.classList.add('hidden')));

    // Scroll reveal
    const obs=new IntersectionObserver(entries=>{
      entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target)}});
    },{threshold:0.1});
    document.querySelectorAll('.reveal,.reveal-scale,.slide-up,.slide-down,.slide-left,.slide-right,.slide-scale').forEach(el=>obs.observe(el));

    // Nav compact on scroll
    const nav=document.getElementById('nav');
    window.addEventListener('scroll',()=>{nav.style.top=window.scrollY>80?'.75rem':'1.5rem'},{passive:true});

    // Theme toggle
    function toggleTheme(){
      const html=document.documentElement;
      const current=html.getAttribute('data-theme');
      if(current==='science'){html.removeAttribute('data-theme');localStorage.setItem('theme','mind')}
      else{html.setAttribute('data-theme','science');localStorage.setItem('theme','science')}
    }

    // Search
    function toggleSearch(){
      const o=document.getElementById('search-overlay');
      o.style.display='flex';
      requestAnimationFrame(()=>{o.style.opacity='1'});
      setTimeout(()=>document.getElementById('search-input').focus(),100);
    }
    function closeSearch(){
      const o=document.getElementById('search-overlay');
      o.style.opacity='0';
      setTimeout(()=>{o.style.display='none'},250);
    }
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeSearch()});

    // Day = mind windflow, night = brain neuron constellation.
    (function(){
      const canvas=document.getElementById('bm-atmosphere');
      if(!canvas)return;
      const ctx=canvas.getContext('2d');
      let width=0,height=0,dpr=1,particles=[],mode='',raf=0;
      const prefersReduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function currentMode(){return document.documentElement.getAttribute('data-theme')==='science'?'night':'day'}
      function resize(){
        dpr=Math.min(window.devicePixelRatio||1,2);
        width=window.innerWidth;height=window.innerHeight;
        canvas.width=width*dpr;canvas.height=height*dpr;
        canvas.style.width=width+'px';canvas.style.height=height+'px';
        ctx.setTransform(dpr,0,0,dpr,0,0);
        seed();
      }
      function seed(){
        mode=currentMode();
        const count=mode==='night'?34:46;
        particles=Array.from({length:count},()=>({
          x:Math.random()*width,
          y:Math.random()*height,
          vx:mode==='night'?(Math.random()-.5)*.08:.05+Math.random()*.16,
          vy:mode==='night'?(Math.random()-.5)*.08:.12+Math.random()*.34,
          r:mode==='night'?.8+Math.random()*1.5:.7+Math.random()*1.8,
          a:Math.random()*Math.PI*2
        }));
      }
      function draw(t){
        if(currentMode()!==mode)seed();
        ctx.clearRect(0,0,width,height);
        if(mode==='night'){
          particles.forEach(p=>{
            p.x+=p.vx;p.y+=p.vy;
            if(p.x<0||p.x>width)p.vx*=-1;
            if(p.y<0||p.y>height)p.vy*=-1;
          });
          for(let i=0;i<particles.length;i++){
            for(let j=i+1;j<particles.length;j++){
              const a=particles[i],b=particles[j],dist=Math.hypot(a.x-b.x,a.y-b.y);
              if(dist<150){
                const o=(1-dist/150)*(.16+.18*Math.sin(t*.0007+a.a+b.a));
                ctx.strokeStyle=`rgba(122,166,255,${o})`;
                ctx.lineWidth=.7;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();
              }
            }
          }
          particles.forEach(p=>{
            const o=.45+.42*Math.sin(p.a+t*.001);
            ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
            ctx.fillStyle=`rgba(216,225,244,${o})`;ctx.fill();
          });
        }else{
          particles.forEach(p=>{
            p.x+=p.vx+Math.sin(t*.0006+p.a)*.22;p.y+=p.vy;
            if(p.y>height+10){p.y=-10;p.x=Math.random()*width}
            if(p.x>width+10)p.x=-10;
            const o=.08+.12*Math.sin(p.a+t*.001);
            ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
            ctx.fillStyle=`rgba(201,106,79,${o+.12})`;ctx.fill();
          });
          ctx.globalAlpha=.04;
          for(let i=0;i<7;i++){
            const x=((t*.018+i*width/7)%(width+90))-45;
            ctx.fillStyle='rgba(201,106,79,1)';
            ctx.fillRect(x,0,.7,height);
          }
          ctx.globalAlpha=1;
        }
        if(!prefersReduced)raf=requestAnimationFrame(draw);
      }
      resize();window.addEventListener('resize',resize,{passive:true});
      if(prefersReduced)draw(0);else raf=requestAnimationFrame(draw);
      new MutationObserver(()=>seed()).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
      window.addEventListener('pagehide',()=>cancelAnimationFrame(raf));
    })();

    // Shared article left TOC active state.
    (function(){
      const links=[...document.querySelectorAll('.article-left-toc a[href^="#"]')];
      if(!links.length)return;
      const targets=links.map(link=>document.querySelector(link.getAttribute('href'))).filter(Boolean);
      function updateArticleToc(){
        let active=0;
        targets.forEach((target,index)=>{if(window.scrollY>=target.getBoundingClientRect().top+window.scrollY-180)active=index});
        links.forEach((link,index)=>link.classList.toggle('active',index===active));
      }
      window.addEventListener('scroll',updateArticleToc,{passive:true});
      updateArticleToc();
    })();
  </script>
  <slot name="scripts" />
</body>
</html>
